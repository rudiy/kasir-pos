# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.
# .env sudah ada di .gitignore, tapi kalau .env lama sempat ter-commit ke history,
# cabut dari tracking dengan: git rm --cached .env

PORT=3000
NODE_ENV=development

# Generate nilai acak 256 bit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Backup otomatis (opsional, nilai bawaan di kurung siku).
# BACKUP_INTERVAL_MIN=60   interval menit; 0 untuk mematikan cadangan otomatis
# BACKUP_KEEP=14           banyak berkas terbaru yang dipertahankan di folder backup/
# BACKUP_DIR=backup        folder tujuan; sebaiknya di disk/partisi lain bila memungkinkan

# Pengiriman cadangan ke email (opsional). Kredensial HANYA hidup di berkas ini dan tidak
# pernah masuk database, jadi berkas cadangan maupun salinan .db aman kalau ikut tersebar.
# Isi SMTP_HOST + SMTP_USER + SMTP_PASS, lalu aktifkan alamat tujuannya di halaman Pengaturan.
#   Gmail: host smtp.gmail.com, port 465, user alamat lengkap, PASS Sandi Aplikasi
#   (bukan sandi akun; buat di Google Account → Security → 2-Step Verification → App passwords).
# SMTP_HOST=
# SMTP_PORT=465            465 = TLS langsung; 587 = STARTTLS (dipilih otomatis kalau kosong)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=               pengirim; kosong berarti ikut SMTP_USER
# SMTP_SECURE=true         paksa 465/true atau 587/false; kosong berarti ikut nomor port
# SMTP_TIMEOUT_MS=25000    batas waktu sambung + per kalimat SMTP
# SMTP_CA_FILE=            hanya kalau server SMTP memakai CA privat; tanpa ini sertifikat
#                          selalu diverifikasi dan server self-signed ditolak
# EMAIL_BACKUP_INTERVAL_MIN=5  seberapa sering penjadwal mengecek apakah sudah waktunya kirim
#                              (emailnya tetap cuma sekali sehari, di jam yang disimpan di /pengaturan)

# Sandi akun kunci (opsional). Isi lalu start ulang untuk membuat/mengatur ulang akunnya:
#   ADMIN_PASSWORD        → akun 'admin' (Administrator / super admin)
#   ADMIN_CABANG_USERNAME → nama akun admin cabang; bawaannya admin_cabang
#   ADMIN_CABANG_PASSWORD → sandinya; kosong berarti ikut ADMIN_PASSWORD
#   ADMIN_CABANG_BRANCH   → id cabang milik akun cabang itu (lihat halaman Cabang)
# Reset hanya jalan kalau nilainya BERUBAH sejak start terakhir, jadi ganti sandi dari dalam
# aplikasi tidak tertimpa setiap restart. Lupa sandi lagi? Ubah satu karakter di sini, restart.
# Kalau baris-baris ini dibiarkan kosong, perilaku lama tetap berlaku: akun admin dibuat dengan
# sandi default admin12345 dan dipaksa ganti saat login pertama.
# ADMIN_PASSWORD=
# ADMIN_CABANG_USERNAME=admin_cabang
# ADMIN_CABANG_PASSWORD=
# ADMIN_CABANG_BRANCH=1
