<%- include('layout-header') %>
<%
  const stockMap = {};
  stocks.forEach(s => { (stockMap[s.product_id] = stockMap[s.product_id] || []).push(s); });
  const currentBranch = branches.find(b => b.id === branchId) || {};
%>
<div class='p-4'>
  <div class='d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2'>
    <div>
      <h2 class='mb-0'>Data Produk</h2>
      <small class='text-muted'>Stok dihitung per cabang. Kolom Stok Cabang memakai cabang <strong><%= currentBranch.name || branchId %></strong>.</small>
    </div>
    <div class='d-flex gap-2 align-items-center'>
      <% if (isAdmin) { %>
        <select id='branchSwitcher' class='form-select form-select-sm'>
          <% branches.forEach(b => { %><option value='<%= b.id %>' <%= b.id === branchId ? "selected" : "" %>><%= b.name %></option><% }) %>
        </select>
      <% } %>
      <button class='btn btn-primary' onclick='openAddProductModal()' style='background-color: var(--navy);'>+ Tambah Produk</button>
    </div>
  </div>
  <% if (typeof imporPesan !== 'undefined' && imporPesan) { %>
    <div class='alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center'>
      <span><i class='bi bi-check-circle-fill me-1'></i> Impor selesai: <%= imporPesan %>.</span>
      <button type='button' class='btn-close' data-bs-dismiss='alert'></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class='alert alert-danger alert-dismissible fade show d-flex justify-content-between align-items-center'>
      <span><i class='bi bi-exclamation-octagon-fill me-1'></i> <%= error %></span>
      <button type='button' class='btn-close' data-bs-dismiss='alert'></button>
    </div>
  <% } %>
  <% if (isManagerOrAdmin) { %>
  <div class='card shadow-sm mb-3'>
    <div class='card-header bg-white d-flex justify-content-between align-items-center' role='button' data-bs-toggle='collapse' data-bs-target='#kotakImpor' aria-expanded='false'>
      <span class='fw-bold'><i class='bi bi-file-earmark-spreadsheet me-1'></i>Impor massal dari Excel</span>
      <small class='text-muted'>klik untuk buka/tutup</small>
    </div>
    <div class='collapse' id='kotakImpor'>
      <div class='card-body'>
        <div class='row g-4'>
          <div class='col-12 col-lg-5'>
            <div class='fw-bold mb-1'>1. Unduh template</div>
            <p class='small text-muted'>Isinya semua produk yang sudah ada beserta stok tiap cabang, jadi file yang sama bisa dipakai untuk koreksi harga atau restok.</p>
            <a class='btn btn-sm btn-outline-primary' href='/produk/template'><i class='bi bi-download'></i> Unduh template CSV</a>
          </div>
          <div class='col-12 col-lg-7'>
            <div class='fw-bold mb-1'>2. Isi di Excel, lalu unggah</div>
            <form action='/produk/impor' method='POST' enctype='multipart/form-data' class='d-flex flex-wrap gap-2 align-items-center mb-2'>
              <input type='file' name='berkas' accept='.csv,text/csv' class='form-control form-control-sm' style='max-width: 280px' required>
              <button type='submit' class='btn btn-sm btn-primary' style='background-color: var(--navy);'>Impor</button>
            </form>
            <ul class='small text-muted mb-0'>
              <li>Wajib ada: kolom <code>nama</code> dan <code>harga_jual</code>. Kolom lain boleh kosong.</li>
              <li>Simpan sebagai <strong>CSV (Pemisah Titik-Koma)</strong>. Berkas .xlsx tidak dibaca. Baris berawalan <code>#</code> dianggap petunjuk dan dilewati.</li>
              <li>Kolom <code>stok_</code> adalah <strong>stok akhir</strong> di cabang itu, bukan tambahan. Sel kosong = stok cabang itu tidak disentuh.</li>
              <li>Barcode yang sudah terdaftar akan <strong>diperbarui</strong>, tidak diduplikat. Barcode kosong diisi otomatis.</li>
              <li>Kategori baru dibuat otomatis.</li>
              <li>Satu file masuk sekaligus: kalau ada satu baris yang salah, tidak ada data yang tersimpan.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
  <div class='card shadow-sm'>
    <div class='card-body table-responsive'>
      <table class='table table-hover align-middle'>
        <thead class='table-light'>
          <tr>
            <th></th>
            <th>Barcode / SKU</th>
            <th>Nama</th>
            <th>Kategori</th>
            <th>Harga Beli</th>
            <th>Harga Jual</th>
            <th>Stok Cabang</th>
            <th>Total Cabang</th>
            <th>Status</th>
            <th class='text-center'>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if(products.length > 0) { products.forEach(p => { const rows = stockMap[p.id] || []; %>
            <tr>
              <td><button class='btn btn-sm btn-outline-secondary' onclick='toggleStockDetail(<%= p.id %>)' title='Sebaran per cabang'><i class='bi bi-geo-alt'></i></button></td>
              <td><code><%= p.barcode || '-' %></code></td>
              <td><strong><%= p.name %></strong></td>
              <td><%= p.category || '-' %></td>
              <td>Rp <%= (p.price_buy || 0).toLocaleString('id-ID') %></td>
              <td>Rp <%= (p.price_sell || 0).toLocaleString('id-ID') %></td>
              <td><span class='badge <%= p.branch_stock === 0 ? "bg-secondary" : (p.branch_stock <= p.min_stock ? "bg-danger" : "bg-success") %>'><%= p.branch_stock %></span></td>
              <td><%= p.total_stock %></td>
              <td>
                <form action='/produk/toggle-status' method='POST' class='d-inline'>
                  <input type='hidden' name='id' value='<%= p.id %>'>
                  <input type='hidden' name='is_active' value='<%= p.is_active === 1 ? 0 : 1 %>'>
                  <button type='submit' class='btn btn-sm <%= p.is_active === 1 ? "btn-success" : "btn-outline-danger" %>'><%= p.is_active === 1 ? "Aktif" : "Nonaktif" %></button>
                </form>
              </td>
              <td class='text-center'>
                <button class='btn btn-sm btn-warning me-1' onclick='editProduct(<%= JSON.stringify(p).replace(/</g, "\\u003c") %>)'><i class='bi bi-pencil'></i></button>
                <form action='/produk/delete' method='POST' class='d-inline' onsubmit='return confirm("Yakin ingin menghapus produk ini?")'>
                  <input type='hidden' name='id' value='<%= p.id %>'>
                  <button type='submit' class='btn btn-sm btn-danger'><i class='bi bi-trash'></i></button>
                </form>
              </td>
            </tr>
            <tr id='stock-detail-<%= p.id %>' style='display:none'>
              <td colspan='10' class='bg-light'>
                <div class='d-flex flex-wrap gap-3'>
                  <% rows.forEach(r => { %>
                    <div class='border rounded p-2' style='min-width: 210px;'>
                      <div class='small fw-bold'><%= r.branch_name %></div>
                      <div>Stok <strong class='<%= r.stock <= r.min_stock ? "text-danger" : "text-success" %>'><%= r.stock %></strong> <small class='text-muted'>(min <%= r.min_stock %>)</small></div>
                      <% if (canUseBranch(r.branch_id)) { %>
                        <form action='/stok/adjust' method='POST' class='mt-2 d-flex gap-1'>
                          <input type='hidden' name='product_id' value='<%= p.id %>'>
                          <input type='hidden' name='branch_id' value='<%= r.branch_id %>'>
                          <input type='number' name='stock_real' class='form-control form-control-sm' value='<%= r.stock %>' min='0' required style='width:80px;'>
                          <button type='submit' class='btn btn-sm btn-outline-primary'>Koreksi</button>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              </td>
            </tr>
          <% }) } else { %><tr><td colspan='10' class='text-center'>Belum ada produk.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class='modal fade' id='modalAddProduct' tabindex='-1'>
  <div class='modal-dialog'>
    <form action='/produk/add' method='POST' class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Tambah Produk</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <div class='mb-2'>
          <label class='form-label'>Barcode / SKU <small class='text-muted'>(Auto / Bisa Diedit / Scan Barcode)</small></label>
          <div class='input-group'>
            <input type='text' name='barcode' id='add_product_barcode' class='form-control fw-bold' required placeholder='Scan barcode atau gunakan auto'>
            <button class='btn btn-primary' type='button' onclick='bukaPemindaiBarcode()'
                    title='Scan barcode dengan kamera' aria-label='Scan barcode dengan kamera' aria-haspopup='dialog'><i class='bi bi-camera-fill'></i></button>
            <button class='btn btn-outline-secondary' type='button' onclick='generateProductBarcode()'><i class='bi bi-shuffle'></i> Acak</button>
          </div>
        </div>
        <div class='mb-2'><label class='form-label'>Nama Produk</label><input type='text' name='name' class='form-control' required placeholder='Contoh: Kopi Kapal Api 165g'></div>
        <div class='mb-2'><label class='form-label'>Kategori</label>
          <select name='category_id' class='form-select'>
            <% categories.forEach(c => { %><option value='<%= c.id %>'><%= c.name %></option><% }) %>
          </select>
          <div class='form-text'>Daftarnya dikelola di <a href='/kategori'>Kategori Produk</a>.</div>
        </div>
        <div class='row'>
            <div class='col-6 mb-2'><label class='form-label'>Harga Beli</label><input type='number' name='price_buy' class='form-control' required placeholder='0'></div>
            <div class='col-6 mb-2'><label class='form-label'>Harga Jual</label><input type='number' name='price_sell' class='form-control' required placeholder='0'></div>
        </div>
        <div class='row'>
          <div class='col-6 mb-2'>
            <label class='form-label'>Cabang Stok Awal</label>
            <% if (isAdmin) { %>
              <select name='branch_id' class='form-select'>
                <% branches.filter(b => b.is_active === 1).forEach(b => { %><option value='<%= b.id %>'><%= b.name %></option><% }) %>
              </select>
            <% } else { %>
              <input type='text' class='form-control' value='<%= (branches.find(b => b.id === user.branch_id) || {}).name %>' readonly>
            <% } %>
          </div>
          <div class='col-6 mb-2'><label class='form-label'>Stok Awal</label><input type='number' name='stock' class='form-control' required value='10' min='0'></div>
        </div>
        <div class='mb-2'><label class='form-label'>Batas Stok Menipis (semua cabang)</label><input type='number' name='min_stock' class='form-control' value='5' min='0'></div>
        <div class='form-text'>Cabang lain otomatis mendapat stok 0 dan bisa diisi lewat halaman Stok atau Opname.</div>
      </div>
      <div class='modal-footer'><button type='submit' class='btn btn-primary'>Simpan Produk</button></div>
    </form>
  </div>
  <% /* Pemindai duduk DI DALAM #modalAddProduct, bukan di level body seperti di /kasir: Bootstrap 5
         mengunci focus di dalam modal yang terbuka, dan elemen di luar modal akan terus ditarik
         kembali sehingga tombol overlay tidak bisa diketuk. Di sini overlay tetap layar penuh karena
         position:fixed dan .modal tidak punya transform (yang jadi_parent transform akan mengurung
         posisi fixed). */ %>
  <div class='scan-overlay is-hidden' id='scanOverlay' role='dialog' aria-modal='true' aria-label='Scan barcode untuk produk'>
    <div class='scan-atas'>
      <div class='scan-judul' id='scanJudul'>Arahkan barcode ke dalam bingkai</div>
      <button type='button' class='btn btn-sm btn-light' onclick='tutupPemindaiBarcode()' aria-label='Tutup pemindai'><i class='bi bi-x-lg'></i></button>
    </div>
    <div class='scan-video' id='scan-video'></div>
    <div class='scan-status' id='scanStatus' aria-live='polite'></div>
    <div class='scan-bawah'>
      <div class='scan-aksi'>
        <button type='button' class='btn btn-outline-light btn-coba' id='btnCobaLagi' onclick='bukaPemindaiBarcode()'><i class='bi bi-arrow-clockwise me-1'></i>Coba lagi</button>
        <button type='button' class='btn btn-outline-light' id='btnScanFoto' onclick='scanDariFoto()'><i class='bi bi-camera me-1'></i>Ambil foto barcode</button>
      </div>
      <div class='scan-kecil' id='scanPetunjuk'>Satu barcode terbaca langsung mengisi kolom, pemindai menutup sendiri.</div>
      <div class='scan-kecil scan-alternatif' id='scanAlternatif' aria-live='polite'></div>
    </div>
  </div>
  <input type='file' accept='image/*' capture='environment' id='scanFoto' class='d-none' aria-hidden='true' tabindex='-1'>
</div>

<!-- Modal Edit -->
<div class='modal fade' id='modalEditProduct' tabindex='-1'>
  <div class='modal-dialog'>
    <form action='/produk/edit' method='POST' class='modal-content'>
      <div class='modal-header'>
        <div>
          <h5 class='modal-title mb-0'>Edit Produk</h5>
          <small class='text-muted'>Stok tidak diubah di sini — pakai sebaran per cabang atau halaman Opname.</small>
        </div>
        <button type='button' class='btn-close' data-bs-dismiss='modal'></button>
      </div>
      <div class='modal-body'>
        <input type='hidden' name='id' id='edit_id'>
        <div class='mb-2'><label class='form-label'>Barcode / SKU</label><input type='text' name='barcode' id='edit_barcode' class='form-control' required></div>
        <div class='mb-2'><label class='form-label'>Nama Produk</label><input type='text' name='name' id='edit_name' class='form-control' required></div>
        <div class='mb-2'><label class='form-label'>Kategori</label>
          <select name='category_id' id='edit_category' class='form-select'>
            <% categories.forEach(c => { %><option value='<%= c.id %>'><%= c.name %></option><% }) %>
          </select>
          <div class='form-text'>Daftarnya dikelola di <a href='/kategori'>Kategori Produk</a>.</div>
        </div>
        <div class='row'>
            <div class='col-6 mb-2'><label class='form-label'>Harga Beli</label><input type='number' name='price_buy' id='edit_price_buy' class='form-control' required></div>
            <div class='col-6 mb-2'><label class='form-label'>Harga Jual</label><input type='number' name='price_sell' id='edit_price_sell' class='form-control' required></div>
        </div>
        <div class='mb-2'><label class='form-label'>Stok Saat Ini</label><input type='text' class='form-control' id='edit_stock_display' readonly></div>
      </div>
      <div class='modal-footer'><button type='submit' class='btn btn-warning'>Update Produk</button></div>
    </form>
  </div>
</div>

<script>
function generateProductBarcode() {
    const randomDigits = Math.floor(1000000000 + Math.random() * 9000000000);
    document.getElementById('add_product_barcode').value = '899' + randomDigits;
}

function openAddProductModal() {
    generateProductBarcode();
    new bootstrap.Modal(document.getElementById('modalAddProduct')).show();
}

function toggleStockDetail(id) {
    const row = document.getElementById('stock-detail-' + id);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}

const branchSwitcher = document.getElementById('branchSwitcher');
if (branchSwitcher) {
    branchSwitcher.addEventListener('change', (e) => {
        window.location.href = '/produk?branch_id=' + e.target.value;
    });
}

function editProduct(p) {
    document.getElementById('edit_id').value = p.id;
    document.getElementById('edit_barcode').value = p.barcode;
    document.getElementById('edit_name').value = p.name;
    document.getElementById('edit_category').value = p.category_id;
    document.getElementById('edit_price_buy').value = p.price_buy;
    document.getElementById('edit_price_sell').value = p.price_sell;
    document.getElementById('edit_stock_display').value = 'Stok cabang ini: ' + p.branch_stock + ' | semua cabang: ' + p.total_stock;
    new bootstrap.Modal(document.getElementById('modalEditProduct')).show();
}
</script>

<script src='/vendor/html5-qrcode/html5-qrcode.min.js?v=<%= verPemindai %>'></script>
<script>
<% /* Daftar barcode yang sudah ada diambil dari data halaman ini sendiri: query /produk memang
       mengembalikan SELURUH produk (bukan per cabang), jadi tabrakan kode bisa dikenal tanpa
       meminta rute baru. Perlu ada karena products.barcode UNIQUE dan /produk/add membalas
       halaman 500 "Gagal: Barcode sudah digunakan!" kalau kode yang sama dikirim dua kali. */ %>
const SUDAH_ADA = <%- JSON.stringify(products.map(p => ({ id: p.id, barcode: String(p.barcode || ''),
  name: p.name, category_id: p.category_id, price_buy: p.price_buy, price_sell: p.price_sell,
  branch_stock: p.branch_stock, total_stock: p.total_stock }))).replace(/</g, '\\u003c') %>;

// ==================== SCAN BARCODE UNTUK FORM PRODUK ====================
// Kamera yang sama dengan layar kasir, tapi satu kode = satu isian: viewfinder berhenti setelah
// kode pertama terbaca dan tidak ada jalur keranjang di sini. Plumbenya ditulis ulang, bukan
// dipinjam dari views/kasir.ejs, supaya layar kasir yang sudah jalan tidak ikut disentuh; kalau
// nanti disatukan, keduanya harus lewat gerbang yang sama (bentuk constraint dan daftar format
// diperiksa di cek-sintaks.js agar tidak bisa berbeda tanpa sengaja).
const F_PUSTAKA = window.Html5QrcodeSupportedFormats;
const SCAN_FORMAT = F_PUSTAKA ? [F_PUSTAKA.CODE_128, F_PUSTAKA.CODE_39, F_PUSTAKA.ITF, F_PUSTAKA.EAN_13,
  F_PUSTAKA.EAN_8, F_PUSTAKA.UPC_A, F_PUSTAKA.UPC_E, F_PUSTAKA.QR_CODE] : null;

const scanOverlay = document.getElementById('scanOverlay');
const scanJudul = document.getElementById('scanJudul');
const scanStatus = document.getElementById('scanStatus');
const scanPetunjuk = document.getElementById('scanPetunjuk');
const scanAlternatif = document.getElementById('scanAlternatif');
const btnScanFoto = document.getElementById('btnScanFoto');
const scanFoto = document.getElementById('scanFoto');
const kolomBarcode = document.getElementById('add_product_barcode');

let pemindai = null;
let nada = null;

// "Tiit" seperti scanner rakitan, supaya barcode yang masuk ke kolom terdengar dan tidak perlu
// melirik layar. Bentuknya sengaja sama dengan bipScan() di views/kasir.ejs: kalau salah satunya
// diubah, gerbang di scratch-kasir/cek-sintaks.js menegur.
function siapkanAudio() {
  try {
    nada = nada || new (window.AudioContext || window.webkitAudioContext)();
    if (nada.state === 'suspended') nada.resume();
  } catch (err) { /* perangkat tanpa audio: getar tetap dicoba */ }
}

function nadaTunggal(freq, mulai, durasi, volume) {
  const o = nada.createOscillator(), g = nada.createGain();
  o.type = 'sine';
  o.frequency.value = freq;
  g.gain.setValueAtTime(0.0001, nada.currentTime + mulai);
  g.gain.exponentialRampToValueAtTime(volume, nada.currentTime + mulai + 0.008);
  g.gain.exponentialRampToValueAtTime(0.0001, nada.currentTime + mulai + durasi);
  o.connect(g);
  g.connect(nada.destination);
  o.start(nada.currentTime + mulai);
  o.stop(nada.currentTime + mulai + durasi + 0.01);
}

function bipScan() {
  siapkanAudio();
  if (!nada) return;
  try { nadaTunggal(2600, 0, 0.05, 0.28); nadaTunggal(1900, 0.06, 0.05, 0.24); } catch (err) {}
  if (navigator.vibrate) { try { navigator.vibrate(45); } catch (err) {} }
}

function bipTolak() {
  siapkanAudio();
  if (!nada) return;
  try { nadaTunggal(760, 0, 0.06, 0.22); nadaTunggal(760, 0.13, 0.06, 0.22); } catch (err) {}
  if (navigator.vibrate) { try { navigator.vibrate([30, 70, 30]); } catch (err) {} }
}

function statusScan(teks, jenis) {
  scanStatus.textContent = teks || '';
  scanStatus.className = 'scan-status' + (jenis ? ' ' + jenis : '');
}

function siapViewfinder() {
  // getUserMedia hanya hidup di secure context: https:// (tunnel) atau localhost.
  return !!(window.Html5Qrcode && SCAN_FORMAT && window.isSecureContext
    && navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
}

function wadahPemindai() {
  if (!pemindai) pemindai = new window.Html5Qrcode('scan-video',
    { verbose: false, formatsToSupport: SCAN_FORMAT, useBarCodeDetectorIfSupported: true });
  return pemindai;
}

async function hentikanPemindai() {
  const p = pemindai;
  pemindai = null;
  if (!p) return;
  try { await p.stop(); } catch (err) { /* belum sempat jalan atau sudah berhenti */ }
  try { p.clear(); } catch (err) {}
}

function tampilkanOverlay(modeFoto) {
  scanOverlay.classList.toggle('scan-mode-foto', !!modeFoto);
  scanOverlay.classList.remove('scan-gagal', 'is-hidden');
  scanJudul.textContent = modeFoto ? 'Potret barcode: seluruh garis + tepi putih masuk bingkai'
    : 'Arahkan barcode ke dalam bingkai';
  btnScanFoto.innerHTML = modeFoto ? '<i class="bi bi-camera"></i> Potret ulang'
    : '<i class="bi bi-camera"></i> Scan dari foto';
  scanPetunjuk.textContent = modeFoto
    ? 'Kamera HP dibuka untuk tiap potret. Barcode yang terbaca mengisi kolom di belakang layar ini.'
    : 'Satu barcode terbaca langsung mengisi kolom, pemindai menutup sendiri.';
  scanAlternatif.textContent = (modeFoto && !window.isSecureContext)
    ? 'Scan tanpa potret butuh https:// - halaman ini membuka ' + location.origin : '';
}

async function bukaPemindaiBarcode() {
  // Nadanya diminta selagi fungsi ini masih turunan ketukan tombol; di dalam callback kamera
  // browser sudah tidak mau lagi mengizinkan AudioContext baru.
  siapkanAudio();
  if (!siapViewfinder()) { scanDariFoto(); return; }
  tampilkanOverlay(false);
  statusScan('Menyiapkan kamera...');
  try {
    // facingMode dikirim sebagai string polos: createVideoConstraints() di dalam bundel menolak
    // objek dengan lebih dari satu kunci dan hanya mengenal {exact: ...} — {ideal: ...} dibalas
    // "'facingMode' should be string or object with exact as key" sebelum browser menyentuh
    // kamera. String juga yang paling longgar: browser memakainya sebagai ideal, jadi laptop
    // tanpa kamera belakang tetap dapat webcam.
    await wadahPemindai().start({ facingMode: 'environment' },
      {
        fps: 10,
        qrbox: (vw, vh) => {
          const lebar = Math.round(Math.min(vw * 0.9, 340));
          return { width: lebar, height: Math.round(Math.min(lebar * 0.45, vh * 0.45)) };
        },
        rememberLastUsedCamera: true
      },
      padaKodeScan, () => { /* frame tanpa kode: bukan error */ });
    statusScan('');
  } catch (err) {
    await hentikanPemindai();
    tampilkanOverlay(true);
    scanOverlay.classList.add('scan-gagal');
    statusScan(sebabKamera(err) + ' Foto juga bisa dipakai.', 'gagal');
  }
}

// Satu kode lalu selesai - form produk tidak menampung barcode bertubi-tubi seperti kasir.
async function padaKodeScan(kode) {
  const bersih = String(kode || '').trim();
  if (!bersih) return;
  await hentikanPemindai();
  scanOverlay.classList.add('is-hidden');
  statusScan('');
  isiBarcode(bersih);
}

function sebabKamera(err) {
  const teks = String((err && err.name) || '') + ' ' + String((err && err.message) || err || '');
  if (/NotAllowedError|Permission|denied|not allowed|permission policy/i.test(teks)) {
    return 'Izin kamera belum diberikan untuk ' + location.host + '. Ketuk ikon gembok di bilah alamat Chrome, pilih Izinkan, lalu muat ulang halaman.';
  }
  if (/NotReadableError|TrackStart|AbortError|in use|busy/i.test(teks)) {
    return 'Kamera sedang dipegang tab atau aplikasi lain. Tutup itu, lalu ketuk "Coba lagi".';
  }
  if (/NotFoundError|DevicesNotFound/i.test(teks)) return 'Perangkat ini tidak punya kamera yang bisa dipakai halaman.';
  if (/OverconstrainedError|ConstraintNotSatisfied/i.test(teks)) return 'Kamera belakang tidak tersedia di perangkat ini.';
  return 'Kamera tidak bisa dibuka (' + (teks.trim() || 'tanpa nama error') + ').';
}

// Jalur kedua, bekerja di mana saja (bukan getUserMedia): kamera bawaan HP memotret, fotonya dibaca.
function scanDariFoto() {
  if (!window.Html5Qrcode || !SCAN_FORMAT) {
    alert('Pustaka pemindai belum ada di perangkat ini. Muat ulang halaman ini dua kali - kalau masih begitu, buka /vendor/html5-qrcode/html5-qrcode.min.js di tab baru: kalau yang muncul halaman login, file pemindai tidak ada di server kasir dan harus dipulihkan di sana.');
    return;
  }
  tampilkanOverlay(true);
  siapkanAudio();
  if (pemindai) hentikanPemindai();
  statusScan('Kamera HP belum terbuka? Ketuk "Potret ulang".');
  scanFoto.click();
}

async function padaFotoSelesai(ev) {
  const berkas = ev.target.files && ev.target.files[0];
  ev.target.value = '';
  if (!berkas) return;
  tampilkanOverlay(true);
  statusScan('Membaca foto ' + berkas.name + '...');
  try {
    const kode = await wadahPemindai().scanFile(berkas, false);
    await hentikanPemindai();
    scanOverlay.classList.add('is-hidden');
    statusScan('');
    isiBarcode(String(kode || '').trim());
  } catch (err) {
    statusScan('Barcode tidak terbaca dari foto itu. Potret lebih dekat, tegak lurus, jangan sampai ujung garis terpotong.', 'gagal');
  }
}

function isiBarcode(bersih) {
  if (!bersih) return;
  const lama = SUDAH_ADA.find(x => x.barcode === bersih);
  if (lama) { tabrakBarcode(lama); return; }
  kolomBarcode.value = bersih;
  bipScan();
  // Kolom nama berikutnya: yang mengetuk scanner biasanya lanjut mengetik nama, tidak perlu
  // mencari kolomnya dulu.
  const nama = document.querySelector('#modalAddProduct [name="name"]');
  if (nama) nama.focus();
}

// Tabrakan kode diselesaikan di sini, bukan di server (server hanya balas halaman 500).
function tabrakBarcode(lama) {
  bipTolak();
  const lanjut = window.confirm('Barcode ' + lama.barcode + ' sudah dipakai "' + lama.name + '".\n\n'
    + 'OK = buka produk itu untuk diedit (satu kode hanya boleh untuk satu produk).\n'
    + 'Batal = kolom barcode diisi kode acak baru.');
  if (!lanjut) { generateProductBarcode(); kolomBarcode.focus(); return; }
  // Tambah ditutup dulu, Edit dibuka setelahnya - dua modal tidak pernah tampil bersamaan, jadi
  // backdrop dan penguncian gulir halaman tetap milik satu modal saja. Kalau Tambah ternyata
  // sudah tertutup (kode kembar diketahui lewat tombol Simpan setelah modalnya tertutup sendiri),
  // Edit langsung dibuka.
  const modalTambah = document.getElementById('modalAddProduct');
  if (!modalTambah.classList.contains('show')) { editProduct(lama); return; }
  modalTambah.addEventListener('hidden.bs.modal', () => editProduct(lama), { once: true });
  const terbuka = bootstrap.Modal.getInstance(modalTambah);
  if (terbuka) terbuka.hide();
}

function tutupPemindaiBarcode() {
  scanOverlay.classList.add('is-hidden');
  statusScan('');
  hentikanPemindai();
}

// Scanner USB dan ketikan manual lewat jalur yang sama: kalau kodenya sudah ada, simpan tidak
// pernah dikirim - sebelumnya formulir ini berakhir di halaman 500 "Barcode sudah digunakan".
document.querySelector('#modalAddProduct form').addEventListener('submit', (e) => {
  const nilai = String(kolomBarcode.value || '').trim();
  if (!nilai) return;
  const lama = SUDAH_ADA.find(x => x.barcode === nilai);
  if (!lama) return;
  e.preventDefault();
  tabrakBarcode(lama);
});

scanFoto.addEventListener('change', padaFotoSelesai);
// Fase capture, bukan bubble: Bootstrap memasang pendengar ESC di elemen modal itu sendiri, jadi
// handler di level document baru sempat bekerja setelah modalnya menutup sendiri.
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !scanOverlay.classList.contains('is-hidden')) { e.preventDefault(); e.stopPropagation(); tutupPemindaiBarcode(); }
}, true);
addEventListener('pagehide', () => { if (!scanOverlay.classList.contains('is-hidden')) hentikanPemindai(); });
</script>
