<%- include('layout-header') %>
<div class='p-4'>
  <div class='d-flex justify-content-between mb-3'>
    <h2>Penggajian Karyawan / Kasir</h2>
    <button class='btn btn-primary' data-bs-toggle='modal' data-bs-target='#modalPay' style='background-color: var(--navy);'>+ Input Gaji</button>
  </div>
  <div class='card shadow-sm'>
    <div class='card-body table-responsive'>
      <table class='table table-hover align-middle'>
        <thead class='table-light'><tr><th>Tgl Bayar</th><th>Nama Karyawan</th><th>Periode / Bulan</th><th>Jumlah Gaji</th><th>Keterangan</th><th class='text-center'>Aksi</th></tr></thead>
        <tbody>
          <% if(payrolls.length > 0) { payrolls.forEach(p => { %>
            <tr>
              <td><%= new Date(p.date).toLocaleDateString('id-ID') %></td>
              <td><strong><%= p.user_name %></strong></td>
              <td><span class='badge bg-info text-dark'><%= p.month_year %></span></td>
              <td class='text-success fw-bold'>Rp <%= p.amount.toLocaleString('id-ID') %></td>
              <td><%= p.notes || '-' %></td>
              <td class='text-center'>
                <form action='/penggajian/delete' method='POST' class='d-inline' onsubmit='return confirm("Hapus data gaji ini?")'>
                  <input type='hidden' name='id' value='<%= p.id %>'>
                  <button type='submit' class='btn btn-sm btn-danger'><i class='bi bi-trash'></i></button>
                </form>
              </td>
            </tr>
          <% }) } else { %><tr><td colspan='6' class='text-center'>Belum ada riwayat penggajian.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class='modal fade' id='modalPay' tabindex='-1'>
  <div class='modal-dialog'>
    <form action='/penggajian/add' method='POST' class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Input Gaji Karyawan</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <div class='mb-2'><label>Karyawan</label>
            <select name='user_id' class='form-select'>
                <% users.forEach(u => { %><option value='<%= u.id %>'><%= u.name %> (<%= u.role %>)</option><% }) %>
            </select>
        </div>
        <div class='mb-2'><label>Bulan & Tahun (Periode)</label><input type='text' name='month_year' class='form-control' required placeholder='Contoh: November 2026'></div>
        <div class='mb-2'><label>Nominal Gaji (Rp)</label><input type='number' name='amount' class='form-control' required placeholder='0'></div>
        <div class='mb-2'><label>Keterangan / Bonus</label><textarea name='notes' class='form-control' rows='2'></textarea></div>
      </div>
      <div class='modal-footer'><button type='submit' class='btn btn-primary'>Simpan Gaji</button></div>
    </form>
  </div>
</div>
<%- include('layout-footer') %>