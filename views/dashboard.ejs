<%- include('layout-header') %>
<div class='p-4'>
  <div class='d-flex justify-content-between align-items-center mb-3'>
    <div>
        <h2>Dashboard Overview</h2>
        <p class='text-muted mb-0'>Selamat datang, <strong><%= user.name %></strong> (<%= user.role %>)</p>
    </div>
    <div class='d-flex align-items-center'>
        <% if(isAdmin) { %>
            <select id='branch-selector' class='form-select form-select-sm me-2' onchange='changeBranchFilter()'>
                <option value='all' <%= selectedBranch === 'all' ? 'selected' : '' %>>-- Semua Cabang --</option>
                <% branches.forEach(b => { %>
                    <option value='<%= b.id %>' <%= selectedBranch == b.id ? 'selected' : '' %>><%= b.name %> (PIC: <%= b.pic_name %>)</option>
                <% }) %>
            </select>
        <% } %>
        <span class='badge bg-success p-2'><i class='bi bi-circle-fill text-white me-1'></i> Live Auto-Refresh Active</span>
    </div>
  </div>
  
  <div class='row mt-4'>
    <div class='col-md-4 mb-3'>
      <div class='card bg-primary text-white shadow-sm h-100'>
        <div class='card-body'>
          <h5>Penjualan Hari Ini</h5>
          <h3 id='stat-sales-total'>Rp <%= salesToday && salesToday.total ? salesToday.total.toLocaleString('id-ID') : 0 %></h3>
          <small id='stat-sales-count'><%= salesToday && salesToday.count ? salesToday.count : 0 %> Transaksi Terproses</small>
        </div>
      </div>
    </div>

    <% if(isManagerOrAdmin) { %>
    <div class='col-md-4 mb-3'>
      <div class='card bg-danger text-white shadow-sm h-100'>
        <div class='card-body'>
          <h5>Pengeluaran Hari Ini</h5>
          <h3 id='stat-exp-total'>Rp <%= expToday ? expToday.toLocaleString('id-ID') : 0 %></h3>
          <small>Operasional <%= isAdmin ? "+ Gaji" : "Cabang" %></small>
        </div>
      </div>
    </div>
    <div class='col-md-4 mb-3'>
      <div class='card bg-success text-white shadow-sm h-100'>
        <div class='card-body'>
          <h5>Estimasi Laba Hari Ini</h5>
          <h3 id='stat-profit-total'>Rp <%= profitToday ? profitToday.toLocaleString('id-ID') : 0 %></h3>
          <small>Omset - HPP - Pengeluaran</small>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class='col-md-4 mb-3'>
      <div class='card bg-info text-dark shadow-sm h-100'>
        <div class='card-body'>
          <h5>Total Transaksi Kasir</h5>
          <h3 id='stat-tx-count'><%= salesToday && salesToday.count ? salesToday.count : 0 %></h3>
          <small>Transaksi sukses hari ini</small>
        </div>
      </div>
    </div>
    <% } %>

    <div class='col-md-4 mb-3'>
      <div class='card bg-dark text-white shadow-sm h-100'>
        <div class='card-body'>
          <h5>Jumlah Produk Aktif</h5>
          <h3 id='stat-product-count'><%= productCount && productCount.count ? productCount.count : 0 %> SKU</h3>
          <small>Master Data Produk</small>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const formatter = new Intl.NumberFormat('id-ID');
const isManagerOrAdminUser = <%= isManagerOrAdmin ? 'true' : 'false' %>;

function changeBranchFilter() {
    const val = document.getElementById('branch-selector').value;
    window.location.href = '/?branch_id=' + val;
}

async function fetchRealtimeStats() {
    try {
        const branchSelector = document.getElementById('branch-selector');
        const selectedBranch = branchSelector ? branchSelector.value : '';
        const res = await fetch('/api/dashboard-stats?branch_id=' + selectedBranch);
        const data = await res.json();
        
        document.getElementById('stat-sales-total').innerText = 'Rp ' + formatter.format(data.salesToday.total || 0);
        document.getElementById('stat-sales-count').innerText = (data.salesToday.count || 0) + ' Transaksi Terproses';
        document.getElementById('stat-product-count').innerText = (data.productCount.count || 0) + ' SKU';

        if(isManagerOrAdminUser) {
            document.getElementById('stat-exp-total').innerText = 'Rp ' + formatter.format(data.totalExpPay || 0);
            document.getElementById('stat-profit-total').innerText = 'Rp ' + formatter.format(data.profitToday || 0);
        } else {
            const txEl = document.getElementById('stat-tx-count');
            if(txEl) txEl.innerText = data.salesToday.count || 0;
        }
    } catch(err) { console.log('Realtime sync error:', err); }
}

setInterval(fetchRealtimeStats, 5000);
</script>
<%- include('layout-footer') %>