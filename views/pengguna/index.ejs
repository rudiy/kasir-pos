<%- include('../layouts/header') %>
<div class='p-4'>
  <div class='d-flex justify-content-between mb-3'>
    <h2>Manajemen Kasir & Pengguna</h2>
    <button class='btn btn-primary' data-bs-toggle='modal' data-bs-target='#modalAddUser' style='background-color: var(--navy);'>+ Tambah Pengguna</button>
  </div>
  <div class='card shadow-sm'>
    <div class='card-body table-responsive'>
      <table class='table table-hover align-middle'>
        <thead class='table-light'><tr><th>Nama Lengkap</th><th>Username</th><th>Role / Akses</th><th>Status</th><th class='text-center'>Aksi</th></tr></thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.name %></td>
              <td><strong><%= u.username %></strong></td>
              <td><span class='badge <%= u.role === "Administrator" ? "bg-primary" : "bg-info text-dark" %>'><%= u.role %></span></td>
              <td><span class='badge bg-success'>Aktif</span></td>
              <td class='text-center'>
                <button class='btn btn-sm btn-warning me-1' onclick='editUser(<%= JSON.stringify(u) %>)'><i class='bi bi-pencil'></i> Edit / Reset Pass</button>
                <% if(u.id !== user.id) { %>
                <form action='/pengguna/delete' method='POST' class='d-inline' onsubmit='return confirm("Yakin ingin menghapus akun ini?")'>
                  <input type='hidden' name='id' value='<%= u.id %>'>
                  <button type='submit' class='btn btn-sm btn-danger'><i class='bi bi-trash'></i></button>
                </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class='modal fade' id='modalAddUser' tabindex='-1'>
  <div class='modal-dialog'>
    <form action='/pengguna/add' method='POST' class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Tambah Pengguna Baru</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <div class='mb-2'><label>Nama Lengkap</label><input type='text' name='name' class='form-control' required></div>
        <div class='mb-2'><label>Username (Untuk Login)</label><input type='text' name='username' class='form-control' required></div>
        <div class='mb-2'><label>Password</label><input type='password' name='password' class='form-control' required></div>
        <div class='mb-2'><label>Hak Akses (Role)</label>
          <select name='role' class='form-select'>
            <option value='Kasir'>Kasir (Hanya POS & Produk)</option>
            <option value='Administrator'>Administrator (Full Akses)</option>
          </select>
        </div>
      </div>
      <div class='modal-footer'><button type='submit' class='btn btn-primary'>Simpan Akun</button></div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class='modal fade' id='modalEditUser' tabindex='-1'>
  <div class='modal-dialog'>
    <form action='/pengguna/edit' method='POST' class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Edit Pengguna</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <input type='hidden' name='id' id='edit_u_id'>
        <div class='mb-2'><label>Nama Lengkap</label><input type='text' name='name' id='edit_u_name' class='form-control' required></div>
        <div class='mb-2'><label>Username</label><input type='text' name='username' id='edit_u_username' class='form-control' required></div>
        <div class='mb-2'><label>Reset Password (Kosongkan jika tidak ingin diubah)</label><input type='password' name='password' class='form-control' placeholder='Ketik password baru...'></div>
        <div class='mb-2'><label>Hak Akses (Role)</label>
          <select name='role' id='edit_u_role' class='form-select'>
            <option value='Kasir'>Kasir</option>
            <option value='Administrator'>Administrator</option>
          </select>
        </div>
      </div>
      <div class='modal-footer'><button type='submit' class='btn btn-warning'>Update Akun</button></div>
    </form>
  </div>
</div>
<script>
function editUser(u) {
    document.getElementById('edit_u_id').value = u.id;
    document.getElementById('edit_u_name').value = u.name;
    document.getElementById('edit_u_username').value = u.username;
    document.getElementById('edit_u_role').value = u.role;
    new bootstrap.Modal(document.getElementById('modalEditUser')).show();
}
</script>
<%- include('../layouts/footer') %>