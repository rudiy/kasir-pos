<%- include('layout-header') %>
<div class='row g-0 pos-stack'>
  <div class='col-lg-8 p-3 bg-light'>
    <div class='d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2'>
      <div class='small text-muted'>Stok yang tampil &amp; berkurang: <strong><%= branch ? branch.name : 'cabang Anda' %></strong></div>
      <% if (isAdmin) { %>
        <select id='branchSwitcher' class='form-select form-select-sm' style='max-width: 220px;'>
          <% branches.forEach(b => { %><option value='<%= b.id %>' <%= b.id === branch.id ? "selected" : "" %>><%= b.name %></option><% }) %>
        </select>
      <% } %>
    </div>
    <input type='text' id='barcode-input' class='form-control mb-3 p-3 shadow-sm' placeholder='Scan Barcode atau Cari Produk (F2)...' autofocus>
    <div class='row g-2' id='product-grid'>
      <% products.forEach(p => { %>
        <div class='col-6 col-sm-4 col-xl-3'>
          <div class='card product-card h-100' data-product='<%= encodeURIComponent(JSON.stringify(p)) %>' onclick='addToCartFromData(this)'>
            <div class='card-body text-center p-2'>
              <h6 class='card-title text-truncate'><%= p.name %></h6>
              <p class='text-success fw-bold mb-0'>Rp <%= p.price_sell.toLocaleString('id-ID') %></p>
              <small class='text-muted'>Stok: <%= p.stock %></small>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <div class='col-lg-4 pos-cart-panel d-flex flex-column'>
    <div class='p-3 bg-white flex-grow-1' id='cart-items'>
      <div class='text-center text-muted mt-5'>Keranjang Kosong</div>
    </div>
    <div class='p-3 bg-light border-top pos-checkout-bar'>
      <div class='d-flex justify-content-between mb-1 small'><span>Subtotal</span><span id='cart-subtotal'>Rp 0</span></div>
      <div class='d-flex justify-content-between mb-1 small text-danger' id='cart-discount-row' style='display:none'><span>Diskon</span><span id='cart-discount'>Rp 0</span></div>
      <div class='d-flex justify-content-between mb-1 small' id='cart-tax-row' style='display:none'><span>Pajak (<span id='cart-tax-rate'>0</span>%)</span><span id='cart-tax'>Rp 0</span></div>
      <div class='d-flex justify-content-between'><strong>Total:</strong><strong class='fs-4 text-primary' id='cart-total'>Rp 0</strong></div>
      <button class='btn btn-success w-100 py-3 fw-bold' onclick='showPaymentModal()'>BAYAR (F4)</button>
    </div>
  </div>
</div>

<div class='modal fade' id='paymentModal' tabindex='-1'>
  <div class='modal-dialog modal-dialog-centered modal-dialog-scrollable'>
    <div class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Pembayaran</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <div class='mb-2'>
            <label>Pilih Voucher / Diskon</label>
            <select id='voucher-select' class='form-select' onchange='applyVoucher()'>
                <option value=''>-- Tanpa Voucher --</option>
                <% vouchers.forEach(v => { %>
                    <option value='<%= v.id %>' data-value='<%= v.value %>' data-min='<%= v.min_transaction || 0 %>' data-code='<%= v.code %>'><%= v.code %> (Potongan Rp <%= v.value.toLocaleString('id-ID') %><% if (v.min_transaction > 0) { %>, Min. Belanja Rp <%= v.min_transaction.toLocaleString('id-ID') %><% } %>)</option>
                <% }) %>
            </select>
            <div class='form-text' id='voucher-hint'></div>
        </div>

        <div class='card bg-light mb-3'>
          <div class='card-body py-2'>
            <div class='d-flex justify-content-between small'><span>Subtotal</span><span id='pay-subtotal'>Rp 0</span></div>
            <div class='d-flex justify-content-between small text-danger'><span>Diskon</span><span id='pay-discount'>Rp 0</span></div>
            <div class='d-flex justify-content-between small'><span>Pajak</span><span id='pay-tax'>Rp 0</span></div>
            <hr class='my-2'>
            <div class='d-flex justify-content-between align-items-center'><strong>Total</strong><strong class='fs-4 text-primary' id='modal-total'>Rp 0</strong></div>
          </div>
        </div>

        <div class='mb-3'>
          <label>Pelanggan / Member</label>
          <input type='search' id='customer-search' class='form-control' list='customer-options'
                 placeholder='-- Umum (tanpa member) --' autocomplete='off' onchange='pilihPelanggan()'>
          <datalist id='customer-options'>
            <% customers.forEach(c => { %><option value='<%= [c.code, c.name, c.phone].filter(Boolean).join(" - ") %>'></option><% }) %>
          </datalist>
          <div class='form-text' id='customer-hint'></div>
        </div>
        <div class='mb-3'>
          <label>Metode Pembayaran</label>
          <select id='payment-method' class='form-select' onchange='terapkanMetodeBayar()'>
            <option value='TUNAI'>Tunai</option>
            <option value='QRIS'>QRIS</option>
          </select>
        </div>
        <div class='mb-3' id='blok-tunai'>
          <label>Uang Diterima (Rp)</label>
          <div class='d-flex gap-2'>
            <input type='number' id='payment-amount' class='form-control form-control-lg' oninput='calculateChange()'>
            <button type='button' class='btn btn-outline-secondary' id='btn-uang-pas' onclick='uangPas()'>Uang Pas</button>
          </div>
        </div>
        <div class='mb-3' id='blok-kembalian'>
          <label>Kembalian</label>
          <input type='text' id='payment-change' class='form-control form-control-lg fw-bold text-success' readonly>
        </div>
        <div class='mb-3' id='blok-qris' style='display:none'>
          <label>QRIS</label>
          <div id='qris-box' class='text-center border rounded p-2 bg-white'></div>
          <div class='form-text'>Pelanggan memindai QR ini dari aplikasi bank/ e-wallet miliknya.</div>
        </div>
      </div>
      <div class='modal-footer'><button class='btn btn-primary w-100' id='btn-proses' onclick='processCheckout()'>Proses & Cetak Struk</button></div>
    </div>
  </div>
</div>

<div id='print-area' style='display:none;'></div>
<div id='qris-besar' style='display:none;' onclick='tutupQrisBesar()'></div>

<script>
let cart = [];
let cartSubtotal = 0;
let discountVal = 0;
let taxVal = 0;
let finalTotal = 0;
const TAX_RATE = <%= Number(settings.tax_rate || 0) %>;
const CURRENT_BRANCH = <%= branch ? branch.id : 'null' %>;
const formatter = new Intl.NumberFormat('id-ID');
// Label di bawah harus sama persis dengan <option> datalist di atas, supaya hasil ketikan
// bisa dicocokkan tegas. Karakter < di-escape agar nama pelanggan tidak menutup script.
const CUSTOMERS = <%- JSON.stringify(customers.map(c => ({ id: c.id, label: [c.code, c.name, c.phone].filter(Boolean).join(' - ') }))).replace(/</g, '\\u003c') %>;
let customerIdTerpilih = null;

function addToCartFromData(card) {
  try {
    addToCart(JSON.parse(decodeURIComponent(card.dataset.product)));
  } catch (err) {
    alert('Data produk tidak valid, muat ulang halaman.');
  }
}

function addToCart(product) {
  const exist = cart.find(i => i.id === product.id);
  if(exist) { if(exist.qty < product.stock) exist.qty++; else alert('Stok tidak cukup!'); }
  else { cart.push({...product, qty: 1}); }
  renderCart();
}

function updateQty(id, delta) {
  const item = cart.find(i => i.id === id);
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0) cart = cart.filter(i => i.id !== id);
  renderCart();
}

function renderCart() {
  const container = document.getElementById('cart-items');
  cartSubtotal = 0;
  if(cart.length === 0) { container.innerHTML = '<div class="text-center text-muted mt-5">Keranjang Kosong</div>'; updateTotals(); return; }
  let html = '';
  cart.forEach(item => {
    const sub = item.qty * item.price_sell;
    cartSubtotal += sub;
    html += '<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">' +
      '<div><div class="fw-bold">' + item.name + '</div><div class="text-muted small">Rp ' + formatter.format(item.price_sell) + ' x ' + item.qty + '</div></div>' +
      '<div class="text-end"><div class="fw-bold">Rp ' + formatter.format(sub) + '</div>' +
      '<div class="btn-group btn-group-sm mt-1"><button class="btn btn-outline-secondary" onclick="updateQty(' + item.id + ', -1)">-</button><button class="btn btn-outline-secondary" onclick="updateQty(' + item.id + ', 1)">+</button></div></div>' +
    '</div>';
  });
  container.innerHTML = html;
  updateTotals();
}

function selectedVoucher() {
  const select = document.getElementById('voucher-select');
  const option = select.options[select.selectedIndex];
  if (!option || option.value === '') return null;
  return {
    id: parseInt(option.value),
    code: option.dataset.code,
    value: parseFloat(option.dataset.value) || 0,
    minTransaction: parseFloat(option.dataset.min) || 0
  };
}

function updateTotals() {
  const voucher = selectedVoucher();
  const hint = document.getElementById('voucher-hint');
  discountVal = 0;
  if (voucher) {
    if (cartSubtotal < voucher.minTransaction) {
      hint.innerText = 'Voucher ' + voucher.code + ' belum berlaku (butuh subtotal Rp ' + formatter.format(voucher.minTransaction) + ').';
    } else {
      discountVal = Math.min(voucher.value, cartSubtotal);
      hint.innerText = voucher.code + ' terpakai, potongan Rp ' + formatter.format(discountVal) + '.';
    }
  } else {
    hint.innerText = '';
  }

  const afterDiscount = Math.max(0, cartSubtotal - discountVal);
  taxVal = Math.round(afterDiscount * TAX_RATE / 100);
  finalTotal = afterDiscount + taxVal;

  document.getElementById('cart-subtotal').innerText = 'Rp ' + formatter.format(cartSubtotal);
  document.getElementById('cart-tax-rate').innerText = TAX_RATE;
  document.getElementById('cart-tax').innerText = 'Rp ' + formatter.format(taxVal);
  document.getElementById('cart-discount').innerText = '- Rp ' + formatter.format(discountVal);
  document.getElementById('cart-total').innerText = 'Rp ' + formatter.format(finalTotal);
  document.getElementById('cart-discount-row').style.display = discountVal > 0 ? '' : 'none';
  document.getElementById('cart-tax-row').style.display = TAX_RATE > 0 ? '' : 'none';

  document.getElementById('pay-subtotal').innerText = 'Rp ' + formatter.format(cartSubtotal);
  document.getElementById('pay-discount').innerText = '- Rp ' + formatter.format(discountVal);
  document.getElementById('pay-tax').innerText = 'Rp ' + formatter.format(taxVal) + (TAX_RATE > 0 ? ' (' + TAX_RATE + '%)' : '');
  document.getElementById('modal-total').innerText = 'Rp ' + formatter.format(finalTotal);
  terapkanMetodeBayar();
}

function applyVoucher() {
    updateTotals();
}

function showPaymentModal() {
  if(cart.length === 0) return alert('Keranjang kosong!');
  document.getElementById('voucher-select').value = '';
  document.getElementById('payment-amount').value = '';
  document.getElementById('customer-search').value = '';
  pilihPelanggan();
  updateTotals();
  new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

function calculateChange() {
  const amount = parseFloat(document.getElementById('payment-amount').value) || 0;
  const change = amount - finalTotal;
  document.getElementById('payment-change').value = change >= 0 ? 'Rp ' + formatter.format(change) : 'Uang Kurang';
}

// QRIS: blok tunai/kembalian diganti panel gambar QR statis milik cabang. Transaksi
// baru dianggap selesai setelah kasir menekan tombol konfirmasi (uang masuk ke rekening
// dipantau di aplikasi bank, bukan oleh aplikasi ini).
const QRIS_CABANG = <%- JSON.stringify(branch && branch.qris_image ? branch.qris_image : '') %>;
const NAMA_CABANG = <%- JSON.stringify(branch ? branch.name : '') %>;

function terapkanMetodeBayar() {
  const qris = document.getElementById('payment-method').value === 'QRIS';
  document.getElementById('blok-tunai').style.display = qris ? 'none' : '';
  document.getElementById('blok-kembalian').style.display = qris ? 'none' : '';
  document.getElementById('blok-qris').style.display = qris ? '' : 'none';
  document.getElementById('btn-proses').innerText = qris ? 'Sudah Dibayar & Cetak Struk' : 'Proses & Cetak Struk';
  if (qris) renderQris();
  else calculateChange();
}

function renderQris() {
  const box = document.getElementById('qris-box');
  if (!QRIS_CABANG) {
    box.innerHTML = '<div class="alert alert-warning mb-0 text-start small">Cabang ini belum punya gambar QRIS. ' +
      'Upload QRIS statis cabang di menu <strong>Cabang</strong> (Edit cabang &rarr; Gambar QRIS), atau gunakan metode Tunai.</div>';
    return;
  }
  box.innerHTML = '<img src="' + QRIS_CABANG + '" alt="QRIS ' + NAMA_CABANG + '" class="img-fluid" style="max-height:52vh;cursor:zoom-in;">' +
    '<div class="fw-bold mt-2">Nominal: Rp ' + formatter.format(finalTotal) + '</div>' +
    '<div class="small text-muted">Ketuk QR untuk memperbesar supaya mudah dipindai.</div>';
  const qrImg = box.querySelector('img');
  qrImg.addEventListener('click', bukaQrisBesar);
  // Isi modal lebih tinggi dari badan modal, jadi QR yang ada di bawah terpotong kalau tidak
  // digulir, dan pemindai butuh QR utuh. Gulir hanya bila modalnya sudah benar-benar tampil:
  // saat modal dibuka, transisi Bootstrap masih display:none pada frame pertama.
  requestAnimationFrame(gulirKeQris);
  if (!qrImg.complete) qrImg.addEventListener('load', () => requestAnimationFrame(gulirKeQris));
}

function gulirKeQris() {
  const box = document.getElementById('qris-box');
  const pen = box.closest('.modal-body');
  if (!pen) return;
  const kurang = box.getBoundingClientRect().bottom - pen.getBoundingClientRect().bottom;
  if (kurang > 0) pen.scrollTop += kurang;
}

// Layar HP memotong QR di dalam modal yang bisa di-scroll (bagian bawah QR hilang),
// padahal pemindai butuh seluruh QR berikut margin putihnya. Layer ini menutup seluruh
// layar sehingga QR tampil seukuran layar dan tetap terbaca dari jarak 10-20 cm.
function bukaQrisBesar() {
  const layer = document.getElementById('qris-besar');
  layer.innerHTML = '<div class="qris-besar-isi">' +
    '<div class="qris-besar-nama">' + NAMA_CABANG + '</div>' +
    '<img src="' + QRIS_CABANG + '" alt="QRIS ' + NAMA_CABANG + '">' +
    '<div class="qris-besar-nominal">Nominal: Rp ' + formatter.format(finalTotal) + '</div>' +
    '<div class="qris-besar-tutup">Ketuk di mana saja untuk menutup</div></div>';
  layer.style.display = 'flex';
}

function tutupQrisBesar() {
  document.getElementById('qris-besar').style.display = 'none';
}

function uangPas() {
  document.getElementById('payment-amount').value = finalTotal;
  calculateChange();
}

function pilihPelanggan() {
  const teks = document.getElementById('customer-search').value.trim();
  const hint = document.getElementById('customer-hint');
  const cocok = teks ? CUSTOMERS.find(c => c.label === teks) : null;
  customerIdTerpilih = cocok ? cocok.id : null;
  hint.innerText = !teks ? '' : (cocok ? 'Member ' + cocok.label + ' dipilih.' : 'Nama / kode / HP tidak ada di daftar pelanggan.');
  hint.className = 'form-text' + (cocok || !teks ? '' : ' text-danger');
}

async function processCheckout() {
  const metode = document.getElementById('payment-method').value;
  const amount = metode === 'QRIS' ? finalTotal : (parseFloat(document.getElementById('payment-amount').value) || 0);
  if(metode !== 'QRIS' && amount < finalTotal) return alert('Uang pembayaran kurang Rp ' + formatter.format(finalTotal - amount) + '!');
  const voucher = selectedVoucher();
  const payload = { cart: cart.map(i => ({id: i.id, qty: i.qty})), paymentMethod: metode, paymentAmount: amount, voucherId: voucher ? voucher.id : null, customerId: customerIdTerpilih, branchId: CURRENT_BRANCH };
  const res = await fetch('/api/checkout', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
  const data = await res.json();
  if(data.success) { printReceipt(data.invoiceNo, amount, data, metode); cart = []; renderCart(); bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide(); alert('Transaksi Berhasil!'); window.location.reload(); }
  else { alert('Gagal: ' + data.error); }
}

function printReceipt(invoice, amount, result, metode) {
  const pa = document.getElementById('print-area');
  const now = new Date();
  const dateStr = now.toLocaleDateString('id-ID') + ' ' + now.toLocaleTimeString('id-ID');

  let logoHtml = '';
  <% if(settings && settings.logo) { %>
    logoHtml = '<div style="text-align:center;"><img src="<%= settings.logo %>" style="max-height:40px; margin-bottom:5px;"></div>';
  <% } %>

  let h = logoHtml + '<div style="text-align:center; font-family:monospace; margin-bottom:5px;"><strong><%= settings.store_name %></strong><br><%= settings.address %><br>Telp: <%= settings.phone %><br><small>' + dateStr + '</small><br>No: ' + invoice + '</div><hr style="border-top:1px dashed #000;">';
  if(result.customerName) h += '<div style="text-align:center; font-family:monospace;"><small>Member: ' + result.customerName + (result.customerCode ? ' (' + result.customerCode + ')' : '') + '</small></div>';
  cart.forEach(i => { h += '<div style="display:flex; justify-content:space-between;"><span>' + i.name + ' (' + i.qty + ')</span><span>' + formatter.format(i.qty * i.price_sell) + '</span></div>'; });
  h += '<hr style="border-top:1px dashed #000;">';
  h += '<div style="display:flex; justify-content:space-between;"><span>Subtotal</span><span>' + formatter.format(result.subtotal) + '</span></div>';
  if(result.discount > 0) h += '<div style="display:flex; justify-content:space-between; color:red;"><span>Diskon</span><span>-' + formatter.format(result.discount) + '</span></div>';
  if(result.tax > 0) h += '<div style="display:flex; justify-content:space-between;"><span>Pajak <%= Number(settings.tax_rate || 0) %>%</span><span>' + formatter.format(result.tax) + '</span></div>';
  h += '<div style="display:flex; justify-content:space-between;"><strong>Total</strong><strong>' + formatter.format(result.total) + '</strong></div>';
  h += '<div style="display:flex; justify-content:space-between;"><span>Bayar</span><span>' + formatter.format(amount) + '</span></div>';
  h += '<div style="display:flex; justify-content:space-between;"><span>Metode</span><span>' + (metode === 'QRIS' ? 'QRIS' : 'Tunai') + '</span></div>';
  if(metode !== 'QRIS') h += '<div style="display:flex; justify-content:space-between;"><span>Kembali</span><span>' + formatter.format(amount - result.total) + '</span></div>';
  h += '<hr style="border-top:1px dashed #000;"><div style="text-align:center; font-size:10px;"><strong><%= settings.receipt_note || "NOTED: Barang yang sudah dibeli tidak bisa dikembalikan." %></strong><br><%= settings.receipt_footer || "Terima Kasih!" %></div>';
  pa.innerHTML = h;
  const siapCetak = () => {
    // Baru ditampilkan saat benar-benar akan dicetak, supaya isi struk tidak sempat berkedip
    // di layar selama logo menunggu selesai dimuat.
    pa.style.display = 'block';
    document.body.classList.add('print-receipt-mode');
    cetakStrukThermal();
    document.body.classList.remove('print-receipt-mode');
    pa.style.display = 'none';
  };
  // Logo disisipkan ke #print-area sepersekian detik sebelum window.print(). Kalau gambarnya
  // belum selesai dimuat (cache dingin, pertama kali setelah restart, atau koneksi LAN lemot),
  // Chrome sempat mengambil snapshot tanpa logo — itu sebabnya logo kadang ada kadang hilang.
  const logo = pa.querySelector('img');
  if (logo && !logo.complete) {
    let sudah = false;
    const jalan = () => { if (sudah) return; sudah = true; clearTimeout(batas); siapCetak(); };
    const batas = setTimeout(jalan, 1200);
    logo.addEventListener('load', jalan);
    logo.addEventListener('error', jalan);
  } else {
    siapCetak();
  }
}

function filterProductGrid(keyword) {
  const term = (keyword || '').toLowerCase();
  document.querySelectorAll('#product-grid > div').forEach(col => {
    col.style.display = !term || col.textContent.toLowerCase().includes(term) ? '' : 'none';
  });
}

const barcodeInput = document.getElementById('barcode-input');
barcodeInput.addEventListener('input', (e) => filterProductGrid(e.target.value.trim()));
barcodeInput.addEventListener('keydown', (e) => {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  const term = barcodeInput.value.trim().toLowerCase();
  if (!term) { filterProductGrid(''); return; }

  const cards = Array.from(document.querySelectorAll('#product-grid .product-card'));
  const parsed = cards.map(card => { try { return JSON.parse(decodeURIComponent(card.dataset.product)); } catch (err) { return null; } }).filter(Boolean);
  const exact = parsed.find(p => String(p.barcode) === term);
  const matches = parsed.filter(p => String(p.barcode).includes(term) || p.name.toLowerCase().includes(term));

  if (exact) { addToCart(exact); barcodeInput.value = ''; filterProductGrid(''); }
  else if (matches.length === 1) { addToCart(matches[0]); barcodeInput.value = ''; filterProductGrid(''); }
  else if (matches.length > 1) { filterProductGrid(term); }
  else { alert('Produk "' + barcodeInput.value + '" tidak ditemukan.'); }
});

const branchSwitcher = document.getElementById('branchSwitcher');
if (branchSwitcher) {
    branchSwitcher.addEventListener('change', (e) => {
        if (cart.length > 0 && !confirm('Keranjang belum dibayar. Ganti cabang tetap menghapus isi keranjang?')) {
            e.target.value = String(CURRENT_BRANCH);
            return;
        }
        window.location.href = '/kasir?branch_id=' + e.target.value;
    });
}

document.getElementById('paymentModal').addEventListener('shown.bs.modal', gulirKeQris);

document.addEventListener('keydown', (e) => { if(e.key==='F2'){e.preventDefault(); document.getElementById('barcode-input').focus();} else if(e.key==='F4'){e.preventDefault(); showPaymentModal();} });
updateTotals();
</script>
<%- include('layout-footer') %>