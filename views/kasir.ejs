<%- include('layout-header') %>
<div class='row g-0 pos-stack'>
  <% /* col-md, bukan col-lg: sejak 768px keranjang kembali jadi kolom di samping (lihat blok
         kasir di style.css), dan di <= 767,98px kelas kolom ini toh tidak dipakai karena panelnya
         jadi bilah tetap di bawah. */ %>
  <div class='col-md-8 p-3 bg-light pos-produk-col'>
    <div class='d-flex flex-wrap align-items-center gap-2 mb-2'>
      <% /* Nama cabang bukan hiasan: angka stok di kartu dan pengurangannya berasal dari cabang ini,
             dan kasir biasa (tanpa dropdown) satu-satunya jalan untuk tahu itu. Dulu kalimat utuh
             "Stok yang tampil & berkurang: <nama>" yang di HP turun jadi dua baris di atas pencarian;
             sekarang satu chip, keterangannya pindah ke title. */ %>
      <span class='kasir-cabang' title='Stok yang tampil &amp; berkurang dari cabang ini'>
        <i class='bi bi-geo-alt-fill' aria-hidden='true'></i><%= branch ? branch.name : 'cabang Anda' %>
      </span>
      <% if (isAdmin) { %>
        <select id='branchSwitcher' class='form-select form-select-sm kasir-cabang-pilih' aria-label='Ganti cabang'>
          <% branches.forEach(b => { %><option value='<%= b.id %>' <%= b.id === branch.id ? "selected" : "" %>><%= b.name %></option><% }) %>
        </select>
      <% } %>
    </div>
    <div class='input-group input-group-lg kasir-cari mb-2'>
      <span class='input-group-text bg-white' aria-hidden='true'><i class='bi bi-search'></i></span>
      <input type='text' id='barcode-input' class='form-control shadow-sm'
             placeholder='Scan Barcode atau Cari Produk (F2)...' autocomplete='off' autocapitalize='off' spellcheck='false'>
      <% /* Titik mode (hijau/kuning) dan labelnya diisi JavaScript lewat tandaModeScan(): di alamat
             http://192.168.x.x tombol ini membuka potret per item, bukan scan terus-menerus, dan
             bedanya baru kelihatan setelah diketuk kalau tidak diberi tanda. */ %>
      <button type='button' id='btnScan' class='btn btn-primary shadow-sm' onclick='bukaPemindai()'
              title='Pindai barcode dengan kamera' aria-label='Pindai barcode dengan kamera' aria-haspopup='dialog'>
        <i class='bi bi-camera-fill'></i><span class='mode-dot' id='scanModeDot' aria-hidden='true'></span><span class='d-none d-sm-inline ms-1' id='scanModeLabel'>Scan</span>
      </button>
    </div>
    <% /* Katalog digeser mendatar per halaman sampai 991,98px (lihat .produk-slider di style.css),
           jadi produk dipecah rata 12 kartu per slide sejak render: tanpa JavaScript pun susunannya
           sudah benar, dan di layar >= 992px slide-nya hanya menumpuk seperti grid biasa. */ %>
    <div class='produk-slider' id='product-grid'>
      <% for (let awal = 0; awal < products.length; awal += 12) { %>
        <div class='produk-slide row g-2'>
          <% products.slice(awal, awal + 12).forEach(p => { %>
            <div class='produk-kol col-6 col-sm-4 col-xl-3'>
              <div class='card product-card h-100' data-product='<%= encodeURIComponent(JSON.stringify(p)) %>' onclick='addToCartFromData(this)'>
                <div class='card-body text-center p-2'>
                  <div class='produk-nama'>
                    <h6 class='card-title text-truncate'><%= p.name %></h6>
                    <% if (p.barcode) { %><small class='produk-kode'><%= p.barcode %></small><% } %>
                  </div>
                  <p class='text-success fw-bold mb-0'>Rp <%= p.price_sell.toLocaleString('id-ID') %></p>
                  <small class='text-muted'>Stok: <%= p.stock %></small>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <div class='produk-indikator' id='produkIndikator' aria-live='polite'></div>
  </div>
  <div class='col-md-4 pos-cart-panel' id='cartPanel'>
    <div class='keranjang-kepala'>
      <span class='fw-bold'><i class='bi bi-bag-check me-1'></i>Keranjang <span class='badge bg-primary cart-count'>0</span></span>
      <button type='button' class='btn btn-sm btn-light' onclick='tutupKeranjang()' aria-label='Tutup keranjang'><i class='bi bi-x-lg'></i></button>
    </div>
    <div class='p-3 bg-white flex-grow-1' id='cart-items'>
      <div class='text-center text-muted mt-5'>Keranjang Kosong</div>
    </div>
    <div class='p-3 bg-light border-top pos-checkout-bar'>
      <button type='button' class='keranjang-handle' onclick='bukaKeranjang()' aria-controls='cartPanel' aria-expanded='false'>
        <span><i class='bi bi-bag-check me-1'></i>Keranjang</span>
        <span class='badge bg-primary cart-count'>0</span>
        <i class='bi bi-chevron-up'></i>
      </button>
      <div class='rincian-keranjang'>
        <div class='d-flex justify-content-between mb-1 small'><span>Subtotal</span><span id='cart-subtotal'>Rp 0</span></div>
        <div class='d-flex justify-content-between mb-1 small text-danger' id='cart-discount-row' style='display:none'><span>Diskon</span><span id='cart-discount'>Rp 0</span></div>
        <div class='d-flex justify-content-between mb-1 small' id='cart-tax-row' style='display:none'><span>Pajak (<span id='cart-tax-rate'>0</span>%)</span><span id='cart-tax'>Rp 0</span></div>
      </div>
      <div class='total-bayar d-flex align-items-center justify-content-between gap-2'>
        <div class='d-flex align-items-baseline gap-2'><strong>Total:</strong><strong class='fs-4 text-primary' id='cart-total'>Rp 0</strong></div>
        <button class='btn btn-success py-3 fw-bold' onclick='showPaymentModal()'>BAYAR (F4)</button>
      </div>
    </div>
  </div>
</div>

<div class='modal fade' id='paymentModal' tabindex='-1'>
  <div class='modal-dialog modal-dialog-centered modal-dialog-scrollable'>
    <div class='modal-content'>
      <div class='modal-header'><h5 class='modal-title'>Pembayaran</h5><button type='button' class='btn-close' data-bs-dismiss='modal'></button></div>
      <div class='modal-body'>
        <div class='mb-2'>
            <label>Pilih Voucher / Diskon</label>
            <select id='voucher-select' class='form-select' onchange='applyVoucher()'>
                <option value=''>-- Tanpa Voucher --</option>
                <% vouchers.forEach(v => { %>
                    <option value='<%= v.id %>' data-value='<%= v.value %>' data-min='<%= v.min_transaction || 0 %>' data-code='<%= v.code %>'><%= v.code %> (Potongan Rp <%= v.value.toLocaleString('id-ID') %><% if (v.min_transaction > 0) { %>, Min. Belanja Rp <%= v.min_transaction.toLocaleString('id-ID') %><% } %>)</option>
                <% }) %>
            </select>
            <div class='form-text' id='voucher-hint'></div>
        </div>

        <div class='card bg-light mb-3'>
          <div class='card-body py-2'>
            <div class='d-flex justify-content-between small'><span>Subtotal</span><span id='pay-subtotal'>Rp 0</span></div>
            <div class='d-flex justify-content-between small text-danger'><span>Diskon</span><span id='pay-discount'>Rp 0</span></div>
            <div class='d-flex justify-content-between small'><span>Pajak</span><span id='pay-tax'>Rp 0</span></div>
            <hr class='my-2'>
            <div class='d-flex justify-content-between align-items-center'><strong>Total</strong><strong class='fs-4 text-primary' id='modal-total'>Rp 0</strong></div>
          </div>
        </div>

        <div class='mb-3'>
          <label>Pelanggan / Member</label>
          <input type='search' id='customer-search' class='form-control' list='customer-options'
                 placeholder='-- Umum (tanpa member) --' autocomplete='off' onchange='pilihPelanggan()'>
          <datalist id='customer-options'>
            <% customers.forEach(c => { %><option value='<%= [c.code, c.name, c.phone].filter(Boolean).join(" - ") %>'></option><% }) %>
          </datalist>
          <div class='form-text' id='customer-hint'></div>
        </div>
        <div class='mb-3'>
          <label>Metode Pembayaran</label>
          <select id='payment-method' class='form-select' onchange='terapkanMetodeBayar()'>
            <option value='TUNAI'>Tunai</option>
            <option value='QRIS'>QRIS</option>
          </select>
        </div>
        <div class='mb-3' id='blok-tunai'>
          <label>Uang Diterima (Rp)</label>
          <div class='d-flex gap-2'>
            <input type='number' id='payment-amount' class='form-control form-control-lg' oninput='calculateChange()'>
            <button type='button' class='btn btn-outline-secondary' id='btn-uang-pas' onclick='uangPas()'>Uang Pas</button>
          </div>
        </div>
        <div class='mb-3' id='blok-kembalian'>
          <label>Kembalian</label>
          <input type='text' id='payment-change' class='form-control form-control-lg fw-bold text-success' readonly>
        </div>
        <div class='mb-3' id='blok-qris' style='display:none'>
          <label>QRIS</label>
          <div id='qris-box' class='text-center border rounded p-2 bg-white'></div>
          <div class='form-text'>Pelanggan memindai QR ini dari aplikasi bank/ e-wallet miliknya.</div>
        </div>
      </div>
      <div class='modal-footer'><button class='btn btn-primary w-100' id='btn-proses' onclick='processCheckout()'>Proses & Cetak Struk</button></div>
    </div>
  </div>
</div>

<div id='print-area' style='display:none;'></div>
<div id='qris-besar' style='display:none;' onclick='tutupQrisBesar()'></div>

<% /* Pemindai kamera. Dua jalur, satu tombol:
       - viewfinder langsung (butuh secure context: https tunnel atau localhost),
       - ambil foto lewat kamera bawaan HP bila halaman dibuka lewat http://192.168.x.x,
         karena browser menolak getUserMedia di konteks tidak aman.
     Elemen #scan-video diisi <video> oleh pustaka, jadi tidak boleh diberi isi. */ %>
<div class='scan-overlay is-hidden' id='scanOverlay' role='dialog' aria-modal='true' aria-label='Pindai barcode dengan kamera'>
  <div class='scan-atas'>
    <div class='scan-judul' id='scanJudul'>Arahkan barcode ke dalam bingkai</div>
    <button type='button' class='btn btn-sm btn-light' onclick='tutupPemindai()' aria-label='Tutup pemindai'><i class='bi bi-x-lg'></i></button>
  </div>
  <div class='scan-video' id='scan-video'></div>
  <div class='scan-status' id='scanStatus' aria-live='polite'></div>
  <div class='scan-bawah'>
    <div class='scan-aksi'>
      <button type='button' class='btn btn-outline-light btn-coba' id='btnCobaLagi' onclick='mulaiViewfinder()'><i class='bi bi-arrow-clockwise me-1'></i>Coba lagi</button>
      <button type='button' class='btn btn-outline-light' id='btnScanFoto' onclick='mulaiModeFoto()'><i class='bi bi-camera me-1'></i>Ambil foto barcode</button>
    </div>
    <div class='scan-kecil' id='scanPetunjuk'>Scan terus-menerus: tiap barcode yang terbaca langsung masuk keranjang.</div>
    <div class='scan-kecil scan-alternatif' id='scanAlternatif' aria-live='polite'></div>
  </div>
</div>
<input type='file' accept='image/*' capture='environment' id='scanFoto' class='d-none' aria-hidden='true' tabindex='-1'>

<script src='/vendor/html5-qrcode/html5-qrcode.min.js'></script>
<script>
let cart = [];
let cartSubtotal = 0;
let discountVal = 0;
let taxVal = 0;
let finalTotal = 0;
const TAX_RATE = <%= Number(settings.tax_rate || 0) %>;
const CURRENT_BRANCH = <%= branch ? branch.id : 'null' %>;
const formatter = new Intl.NumberFormat('id-ID');
// Nama produk masuk ke keranjang sebagai HTML (baris dibuat dengan string, sama seperti
// sebelumnya), jadi karakter & < > " ' ditutup dulu supaya nama seperti "A<B \"x\"" tidak
// merusak baris atau menyelipkan tag.
const escHtml = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
// Label di bawah harus sama persis dengan <option> datalist di atas, supaya hasil ketikan
// bisa dicocokkan tegas. Karakter < di-escape agar nama pelanggan tidak menutup script.
const CUSTOMERS = <%- JSON.stringify(customers.map(c => ({ id: c.id, label: [c.code, c.name, c.phone].filter(Boolean).join(' - ') }))).replace(/</g, '\\u003c') %>;
let customerIdTerpilih = null;

function addToCartFromData(card) {
  try {
    const hasil = addToCart(JSON.parse(decodeURIComponent(card.dataset.product)));
    if (hasil.status === 'stok-habis') alert('Stok ' + hasil.produk.name + ' tinggal ' + hasil.stok + ', keranjang sudah penuh.');
  } catch (err) {
    alert('Data produk tidak valid, muat ulang halaman.');
  }
}

//addToCart tidak lagi menampilkan alert sendiri: jalur scan memakai baris statusnya, supaya
//dialog 'Stok tidak cukup' tidak muncul di atas layar pemindai untuk tiap barcode yang habis.
function addToCart(product) {
  const exist = cart.find(i => i.id === product.id);
  let hasil;
  if (exist) {
    if (exist.qty < product.stock) { exist.qty++; hasil = { status: 'naik', produk: product, qty: exist.qty }; }
    else hasil = { status: 'stok-habis', produk: product, stok: product.stock };
  } else {
    cart.push({ ...product, qty: 1 });
    hasil = { status: 'baru', produk: product, qty: 1 };
  }
  renderCart();
  return hasil;
}

function updateQty(id, delta) {
  const item = cart.find(i => i.id === id);
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0) cart = cart.filter(i => i.id !== id);
  renderCart();
}

function hapusBarang(id) {
  cart = cart.filter(i => i.id !== id);
  renderCart();
}

function renderCart() {
  const container = document.getElementById('cart-items');
  cartSubtotal = 0;
  const jumlah = cart.reduce((n, i) => n + i.qty, 0);
  document.querySelectorAll('.cart-count').forEach(el => { el.textContent = jumlah; });
  if(cart.length === 0) {
    container.innerHTML = '<div class="text-center text-muted mt-5">Keranjang Kosong</div>';
    // Bilah yang tersisa cuma total Rp 0 + BAYAR: kalau keranjang dibuka dalam keadaan kosong,
    // tutup lagi supaya daftar produk tidak tertutup layar kosong.
    if (document.body.classList.contains('keranjang-terbuka')) document.body.classList.remove('keranjang-terbuka');
    updateTotals();
    return;
  }
  let html = '';
  cart.forEach(item => {
    const sub = item.qty * item.price_sell;
    cartSubtotal += sub;
    const nama = escHtml(item.name);
    html += '<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">' +
      '<div class="keranjang-nama"><div class="fw-bold">' + nama + '</div>' +
      '<div class="text-muted small">Rp ' + formatter.format(item.price_sell) + ' &times; ' + item.qty + '</div></div>' +
      '<div class="text-end"><div class="fw-bold">Rp ' + formatter.format(sub) + '</div>' +
      '<div class="btn-group btn-group-sm mt-1">' +
      '<button class="btn btn-outline-secondary" onclick="updateQty(' + item.id + ', -1)" aria-label="Kurangi ' + nama + '">&minus;</button>' +
      '<button class="btn btn-outline-secondary" onclick="updateQty(' + item.id + ', 1)" aria-label="Tambah ' + nama + '">+</button>' +
      '<button class="btn btn-outline-danger" onclick="hapusBarang(' + item.id + ')" aria-label="Hapus ' + nama + '"><i class="bi bi-trash3"></i></button>' +
      '</div></div>' +
    '</div>';
  });
  container.innerHTML = html;
  updateTotals();
}

function selectedVoucher() {
  const select = document.getElementById('voucher-select');
  const option = select.options[select.selectedIndex];
  if (!option || option.value === '') return null;
  return {
    id: parseInt(option.value),
    code: option.dataset.code,
    value: parseFloat(option.dataset.value) || 0,
    minTransaction: parseFloat(option.dataset.min) || 0
  };
}

function updateTotals() {
  const voucher = selectedVoucher();
  const hint = document.getElementById('voucher-hint');
  discountVal = 0;
  if (voucher) {
    if (cartSubtotal < voucher.minTransaction) {
      hint.innerText = 'Voucher ' + voucher.code + ' belum berlaku (butuh subtotal Rp ' + formatter.format(voucher.minTransaction) + ').';
    } else {
      discountVal = Math.min(voucher.value, cartSubtotal);
      hint.innerText = voucher.code + ' terpakai, potongan Rp ' + formatter.format(discountVal) + '.';
    }
  } else {
    hint.innerText = '';
  }

  const afterDiscount = Math.max(0, cartSubtotal - discountVal);
  taxVal = Math.round(afterDiscount * TAX_RATE / 100);
  finalTotal = afterDiscount + taxVal;

  document.getElementById('cart-subtotal').innerText = 'Rp ' + formatter.format(cartSubtotal);
  document.getElementById('cart-tax-rate').innerText = TAX_RATE;
  document.getElementById('cart-tax').innerText = 'Rp ' + formatter.format(taxVal);
  document.getElementById('cart-discount').innerText = '- Rp ' + formatter.format(discountVal);
  document.getElementById('cart-total').innerText = 'Rp ' + formatter.format(finalTotal);
  document.getElementById('cart-discount-row').style.display = discountVal > 0 ? '' : 'none';
  document.getElementById('cart-tax-row').style.display = TAX_RATE > 0 ? '' : 'none';

  document.getElementById('pay-subtotal').innerText = 'Rp ' + formatter.format(cartSubtotal);
  document.getElementById('pay-discount').innerText = '- Rp ' + formatter.format(discountVal);
  document.getElementById('pay-tax').innerText = 'Rp ' + formatter.format(taxVal) + (TAX_RATE > 0 ? ' (' + TAX_RATE + '%)' : '');
  document.getElementById('modal-total').innerText = 'Rp ' + formatter.format(finalTotal);
  terapkanMetodeBayar();
}

function applyVoucher() {
    updateTotals();
}

function showPaymentModal() {
  if(cart.length === 0) return alert('Keranjang kosong!');
  document.getElementById('voucher-select').value = '';
  document.getElementById('payment-amount').value = '';
  document.getElementById('customer-search').value = '';
  pilihPelanggan();
  updateTotals();
  new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

function calculateChange() {
  const amount = parseFloat(document.getElementById('payment-amount').value) || 0;
  const change = amount - finalTotal;
  document.getElementById('payment-change').value = change >= 0 ? 'Rp ' + formatter.format(change) : 'Uang Kurang';
}

// QRIS: blok tunai/kembalian diganti panel gambar QR statis milik cabang. Transaksi
// baru dianggap selesai setelah kasir menekan tombol konfirmasi (uang masuk ke rekening
// dipantau di aplikasi bank, bukan oleh aplikasi ini).
const QRIS_CABANG = <%- JSON.stringify(branch && branch.qris_image ? branch.qris_image : '') %>;
const NAMA_CABANG = <%- JSON.stringify(branch ? branch.name : '') %>;

function terapkanMetodeBayar() {
  const qris = document.getElementById('payment-method').value === 'QRIS';
  document.getElementById('blok-tunai').style.display = qris ? 'none' : '';
  document.getElementById('blok-kembalian').style.display = qris ? 'none' : '';
  document.getElementById('blok-qris').style.display = qris ? '' : 'none';
  document.getElementById('btn-proses').innerText = qris ? 'Sudah Dibayar & Cetak Struk' : 'Proses & Cetak Struk';
  if (qris) renderQris();
  else calculateChange();
}

function renderQris() {
  const box = document.getElementById('qris-box');
  if (!QRIS_CABANG) {
    box.innerHTML = '<div class="alert alert-warning mb-0 text-start small">Cabang ini belum punya gambar QRIS. ' +
      'Upload QRIS statis cabang di menu <strong>Cabang</strong> (Edit cabang &rarr; Gambar QRIS), atau gunakan metode Tunai.</div>';
    return;
  }
  box.innerHTML = '<img src="' + QRIS_CABANG + '" alt="QRIS ' + NAMA_CABANG + '" class="img-fluid" style="max-height:52vh;cursor:zoom-in;">' +
    '<div class="fw-bold mt-2">Nominal: Rp ' + formatter.format(finalTotal) + '</div>' +
    '<div class="small text-muted">Ketuk QR untuk memperbesar supaya mudah dipindai.</div>';
  const qrImg = box.querySelector('img');
  qrImg.addEventListener('click', bukaQrisBesar);
  // Isi modal lebih tinggi dari badan modal, jadi QR yang ada di bawah terpotong kalau tidak
  // digulir, dan pemindai butuh QR utuh. Gulir hanya bila modalnya sudah benar-benar tampil:
  // saat modal dibuka, transisi Bootstrap masih display:none pada frame pertama.
  requestAnimationFrame(gulirKeQris);
  if (!qrImg.complete) qrImg.addEventListener('load', () => requestAnimationFrame(gulirKeQris));
}

function gulirKeQris() {
  const box = document.getElementById('qris-box');
  const pen = box.closest('.modal-body');
  if (!pen) return;
  const kurang = box.getBoundingClientRect().bottom - pen.getBoundingClientRect().bottom;
  if (kurang > 0) pen.scrollTop += kurang;
}

// Layar HP memotong QR di dalam modal yang bisa di-scroll (bagian bawah QR hilang),
// padahal pemindai butuh seluruh QR berikut margin putihnya. Layer ini menutup seluruh
// layar sehingga QR tampil seukuran layar dan tetap terbaca dari jarak 10-20 cm.
function bukaQrisBesar() {
  const layer = document.getElementById('qris-besar');
  layer.innerHTML = '<div class="qris-besar-isi">' +
    '<div class="qris-besar-nama">' + NAMA_CABANG + '</div>' +
    '<img src="' + QRIS_CABANG + '" alt="QRIS ' + NAMA_CABANG + '">' +
    '<div class="qris-besar-nominal">Nominal: Rp ' + formatter.format(finalTotal) + '</div>' +
    '<div class="qris-besar-tutup">Ketuk di mana saja untuk menutup</div></div>';
  layer.style.display = 'flex';
}

function tutupQrisBesar() {
  document.getElementById('qris-besar').style.display = 'none';
}

function uangPas() {
  document.getElementById('payment-amount').value = finalTotal;
  calculateChange();
}

function pilihPelanggan() {
  const teks = document.getElementById('customer-search').value.trim();
  const hint = document.getElementById('customer-hint');
  const cocok = teks ? CUSTOMERS.find(c => c.label === teks) : null;
  customerIdTerpilih = cocok ? cocok.id : null;
  hint.innerText = !teks ? '' : (cocok ? 'Member ' + cocok.label + ' dipilih.' : 'Nama / kode / HP tidak ada di daftar pelanggan.');
  hint.className = 'form-text' + (cocok || !teks ? '' : ' text-danger');
}

async function processCheckout() {
  const metode = document.getElementById('payment-method').value;
  const amount = metode === 'QRIS' ? finalTotal : (parseFloat(document.getElementById('payment-amount').value) || 0);
  if(metode !== 'QRIS' && amount < finalTotal) return alert('Uang pembayaran kurang Rp ' + formatter.format(finalTotal - amount) + '!');
  const voucher = selectedVoucher();
  const payload = { cart: cart.map(i => ({id: i.id, qty: i.qty})), paymentMethod: metode, paymentAmount: amount, voucherId: voucher ? voucher.id : null, customerId: customerIdTerpilih, branchId: CURRENT_BRANCH };
  const res = await fetch('/api/checkout', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) });
  const data = await res.json();
  if(data.success) { printReceipt(data.invoiceNo, amount, data, metode); cart = []; renderCart(); bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide(); alert('Transaksi Berhasil!'); window.location.reload(); }
  else { alert('Gagal: ' + data.error); }
}

function printReceipt(invoice, amount, result, metode) {
  const pa = document.getElementById('print-area');
  const now = new Date();
  const dateStr = now.toLocaleDateString('id-ID') + ' ' + now.toLocaleTimeString('id-ID');

  let logoHtml = '';
  <% if(settings && settings.logo) { %>
    logoHtml = '<div style="text-align:center;"><img src="<%= settings.logo %>" style="max-height:40px; margin-bottom:5px;"></div>';
  <% } %>

  let h = logoHtml + '<div style="text-align:center; font-family:monospace; margin-bottom:5px;"><strong><%= settings.store_name %></strong><br><%= settings.address %><br>Telp: <%= settings.phone %><br><small>' + dateStr + '</small><br>No: ' + invoice + '</div><hr style="border-top:1px dashed #000;">';
  if(result.customerName) h += '<div style="text-align:center; font-family:monospace;"><small>Member: ' + result.customerName + (result.customerCode ? ' (' + result.customerCode + ')' : '') + '</small></div>';
  cart.forEach(i => { h += '<div style="display:flex; justify-content:space-between;"><span>' + i.name + ' (' + i.qty + ')</span><span>' + formatter.format(i.qty * i.price_sell) + '</span></div>'; });
  h += '<hr style="border-top:1px dashed #000;">';
  h += '<div style="display:flex; justify-content:space-between;"><span>Subtotal</span><span>' + formatter.format(result.subtotal) + '</span></div>';
  if(result.discount > 0) h += '<div style="display:flex; justify-content:space-between; color:red;"><span>Diskon</span><span>-' + formatter.format(result.discount) + '</span></div>';
  // Kode voucher ikut tercetak supaya pelanggan dan pemilik punya bukti diskon dari program
  // yang mana; kalau tidak dicetak, potongan harga di nota tidak bisa ditelusuri.
  if(result.voucherCode) h += '<div style="display:flex; justify-content:space-between;"><span>Voucher</span><span>' + result.voucherCode + '</span></div>';
  if(result.tax > 0) h += '<div style="display:flex; justify-content:space-between;"><span>Pajak <%= Number(settings.tax_rate || 0) %>%</span><span>' + formatter.format(result.tax) + '</span></div>';
  h += '<div style="display:flex; justify-content:space-between;"><strong>Total</strong><strong>' + formatter.format(result.total) + '</strong></div>';
  h += '<div style="display:flex; justify-content:space-between;"><span>Bayar</span><span>' + formatter.format(amount) + '</span></div>';
  h += '<div style="display:flex; justify-content:space-between;"><span>Metode</span><span>' + (metode === 'QRIS' ? 'QRIS' : 'Tunai') + '</span></div>';
  if(metode !== 'QRIS') h += '<div style="display:flex; justify-content:space-between;"><span>Kembali</span><span>' + formatter.format(amount - result.total) + '</span></div>';
  h += '<hr style="border-top:1px dashed #000;"><div style="text-align:center; font-size:10px;"><strong><%= settings.receipt_note || "NOTED: Barang yang sudah dibeli tidak bisa dikembalikan." %></strong><br><%= settings.receipt_footer || "Terima Kasih!" %></div>';
  pa.innerHTML = h;
  const siapCetak = () => {
    // Baru ditampilkan saat benar-benar akan dicetak, supaya isi struk tidak sempat berkedip
    // di layar selama logo menunggu selesai dimuat.
    pa.style.display = 'block';
    document.body.classList.add('print-receipt-mode');
    cetakStrukThermal();
    document.body.classList.remove('print-receipt-mode');
    pa.style.display = 'none';
  };
  // Logo disisipkan ke #print-area sepersekian detik sebelum window.print(). Kalau gambarnya
  // belum selesai dimuat (cache dingin, pertama kali setelah restart, atau koneksi LAN lemot),
  // Chrome sempat mengambil snapshot tanpa logo — itu sebabnya logo kadang ada kadang hilang.
  const logo = pa.querySelector('img');
  if (logo && !logo.complete) {
    let sudah = false;
    const jalan = () => { if (sudah) return; sudah = true; clearTimeout(batas); siapCetak(); };
    const batas = setTimeout(jalan, 1200);
    logo.addEventListener('load', jalan);
    logo.addEventListener('error', jalan);
  } else {
    siapCetak();
  }
}

function filterProductGrid(keyword) {
  const term = (keyword || '').toLowerCase();
  document.querySelectorAll('#product-grid .produk-slide').forEach(slide => {
    let kena = 0;
    slide.querySelectorAll('.produk-kol').forEach(col => {
      const cocok = !term || col.textContent.toLowerCase().includes(term);
      col.style.display = cocok ? '' : 'none';
      if (cocok) kena++;
    });
    slide.classList.toggle('slide-kosong', kena === 0);
  });
  document.getElementById('product-grid').scrollLeft = 0;
  perbaruiIndikator();
}

const HP = window.matchMedia('(max-width: 767.98px)');
// Batas katalog digeser: HP dan tablet potret (<= 991.98px) memakai slide mendatar; di atasnya
// slidanya menumpuk menjadi grid biasa dan angkanya disembunyikan CSS.
const LEBAR_SLIDER = window.matchMedia('(max-width: 991.98px)');

// ---------- Slide produk (HP & tablet) ----------
// Produk sudah dipecah 12 per slide di EJS; di sini hanya indikator "2 / 5" yang dihitung dari
// posisi geser, dan hanya saat slider benar-benar bisa digeser.
function slideTerlihat() {
  return Array.from(document.querySelectorAll('#product-grid .produk-slide:not(.slide-kosong)'));
}

function perbaruiIndikator() {
  const chip = document.getElementById('produkIndikator');
  const slider = document.getElementById('product-grid');
  const jumlah = slideTerlihat().length;
  let nomor = 1;
  if (jumlah > 1 && slider.clientWidth > 0) {
    nomor = Math.round(slider.scrollLeft / slider.clientWidth) + 1;
    nomor = Math.min(jumlah, Math.max(1, nomor));
  }
  chip.textContent = jumlah > 1 ? nomor + ' / ' + jumlah : '';
  chip.classList.toggle('ada', jumlah > 1);
}

(function daftarkanSlider() {
  const slider = document.getElementById('product-grid');
  let antre = false;
  slider.addEventListener('scroll', () => {
    if (antre) return;
    antre = true;
    requestAnimationFrame(() => { antre = false; perbaruiIndikator(); });
  }, { passive: true });
  LEBAR_SLIDER.addEventListener('change', perbaruiIndikator);
})()

// ---------- Keranjang: bilah bawah, layar penuh saat dibuka (<= 767.98px) ----------
function setKeranjang(buka) {
  document.body.classList.toggle('keranjang-terbuka', !!buka);
  const gagang = document.querySelector('.keranjang-handle');
  if (gagang) gagang.setAttribute('aria-expanded', String(!!buka));
}
function bukaKeranjang() { setKeranjang(true); }
function tutupKeranjang() { setKeranjang(false); }

// ---------- Teks yang hanya masuk akal di mesin kasir ----------
// (F2)/(F4) tidak ada di keyboard HP, dan autofocus pada kolom cari membuat keyboard
// layar langsung menutupi separuh daftar produk begitu halaman dibuka.
function terapkanTeksPerangkat() {
  const hp = HP.matches;
  barcodeInput.placeholder = hp ? 'Cari produk atau scan barcode' : 'Scan Barcode atau Cari Produk (F2)...';
  const bayar = document.querySelector('.total-bayar .btn-success');
  if (bayar) bayar.textContent = hp ? 'BAYAR' : 'BAYAR (F4)';
  if (!hp) barcodeInput.focus();
}

const barcodeInput = document.getElementById('barcode-input');

function produkSiapDijual() {
  return Array.from(document.querySelectorAll('#product-grid .product-card')).map(card => {
    try { return JSON.parse(decodeURIComponent(card.dataset.product)); } catch (err) { return null; }
  }).filter(Boolean);
}

// Satu jalur untuk scanner USB (Enter di kolom cari), pemindai kamera, dan ketikan manual:
// barcode yang sama persis menang, lalu satu-satunya yang cocok ikut masuk, lebih dari satu
// hanya disaring, dan tidak ada yang masuk kalau nomornya tidak dikenal.
function prosesKode(teks, lewatScan) {
  const term = String(teks || '').trim().toLowerCase();
  if (!term) { filterProductGrid(''); return { status: 'kosong' }; }
  const parsed = produkSiapDijual();
  const exact = parsed.find(p => String(p.barcode || '') === term);
  const matches = parsed.filter(p => String(p.barcode || '').includes(term) || String(p.name).toLowerCase().includes(term));
  const produk = exact || (matches.length === 1 ? matches[0] : null);
  if (!produk) {
    if (matches.length > 1) { filterProductGrid(term); return { status: 'banyak', jumlah: matches.length }; }
    if (!lewatScan) alert('Produk "' + term + '" tidak ditemukan.');
    return { status: 'tidak-ada', teks: term };
  }
  const hasil = addToCart(produk);
  barcodeInput.value = '';
  filterProductGrid('');
  return hasil;
}

barcodeInput.addEventListener('input', (e) => filterProductGrid(e.target.value.trim()));
barcodeInput.addEventListener('keydown', (e) => {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  prosesKode(barcodeInput.value, false);
});

const branchSwitcher = document.getElementById('branchSwitcher');
if (branchSwitcher) {
    branchSwitcher.addEventListener('change', (e) => {
        if (cart.length > 0 && !confirm('Keranjang belum dibayar. Ganti cabang tetap menghapus isi keranjang?')) {
            e.target.value = String(CURRENT_BRANCH);
            return;
        }
        window.location.href = '/kasir?branch_id=' + e.target.value;
    });
}

document.getElementById('paymentModal').addEventListener('shown.bs.modal', gulirKeQris);

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && document.body.classList.contains('keranjang-terbuka')) { tutupKeranjang(); return; }
  if (e.key === 'F2') { e.preventDefault(); barcodeInput.focus(); }
  else if (e.key === 'F4') { e.preventDefault(); showPaymentModal(); }
});

// Lebar berpindah (rotasi HP, jendela PC digeser): label perangkat hanya berubah di batas HP, dan
// keranjang layar penuh cuma punya arti di layout bilah (<= 767,98px) - di layout samping kelasnya
// dibuang lagi supaya tidak tertinggal terbuka.
const padaLebarHPBerubah = () => { if (!HP.matches) setKeranjang(false); terapkanTeksPerangkat(); };
if (HP.addEventListener) HP.addEventListener('change', padaLebarHPBerubah); else if (HP.addListener) HP.addListener(padaLebarHPBerubah);

perbaruiIndikator();
terapkanTeksPerangkat();
updateTotals();
</script>
<script>
// ==================== PEMINDAI BARCODE KAMERA ====================
// Pustaka html5-qrcode dilayani dari public/vendor (bukan CDN) supaya pemindai tetap jalan
// saat internet toko mati. Pustakanya yang memakai BarcodeDetector bawaan browser bila ada
// dan decoder miliknya bila tidak — iOS Safari tidak punya BarcodeDetector sama sekali.
// Nama panjang sengaja dipakai: ini konstanta tingkat global di halaman, dan satu huruf
// cepat bertabrakan dengan blok script lain yang ikut dirender.
const FORMAT_PUSTAKA = window.Html5QrcodeSupportedFormats;
// Yang ditempel di kemasan toko adalah EAN-13/EAN-8/UPC, label cetakan /barcode adalah
// Code 128, dan QR ikut karena QRIS serta kode pada kemasan supplier.
const SCAN_FORMAT = FORMAT_PUSTAKA ? [FORMAT_PUSTAKA.CODE_128, FORMAT_PUSTAKA.CODE_39, FORMAT_PUSTAKA.ITF,
  FORMAT_PUSTAKA.EAN_13, FORMAT_PUSTAKA.EAN_8, FORMAT_PUSTAKA.UPC_A, FORMAT_PUSTAKA.UPC_E, FORMAT_PUSTAKA.QR_CODE] : null;

const scanOverlay = document.getElementById('scanOverlay');
const scanJudul = document.getElementById('scanJudul');
const scanStatus = document.getElementById('scanStatus');
const scanPetunjuk = document.getElementById('scanPetunjuk');
const btnScanFoto = document.getElementById('btnScanFoto');
const scanAlternatif = document.getElementById('scanAlternatif');
const scanFoto = document.getElementById('scanFoto');

let pemindai = null;
let pemindaiJalan = false;
let kodeTerakhir = '';
let waktuKodeTerakhir = 0;
// Satu barcode yang dibiarkan di depan kamera terbaca berulang kali (10 fps); tanpa jeda ini
// 1 sachet jadi 10 sachet di keranjang.
const JEDA_ULANG_SCAN = 2200;
let nada = null;

function bisaViewfinder() {
  // getUserMedia hanya hidup di secure context: https:// (tunnel) atau localhost ya,
  // http://192.168.x.x:3000 tidak. Yang menolak adalah browser, bukan aplikasinya.
  return !!(window.Html5Qrcode && SCAN_FORMAT && window.isSecureContext
    && navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
}

function statusScan(teks, jenis) {
  scanStatus.textContent = teks || '';
  scanStatus.className = 'scan-status' + (jenis ? ' ' + jenis : '');
}

function tampilkanOverlay(modeFoto) {
  scanOverlay.classList.toggle('scan-mode-foto', !!modeFoto);
  scanOverlay.classList.remove('scan-gagal', 'is-hidden');
  btnScanFoto.innerHTML = modeFoto ? '<i class="bi bi-camera"></i> Potret ulang'
    : '<i class="bi bi-camera"></i> Scan dari foto';
  scanJudul.textContent = modeFoto ? 'Potret barcode: seluruh garis + tepi putih masuk bingkai'
    : 'Arahkan barcode ke dalam bingkai';
  scanPetunjuk.textContent = modeFoto
    ? 'Kamera HP dibuka untuk tiap potret. Kalau barcode sulit fokus, gunakan scanner USB.'
    : 'Scan terus-menerus: tiap barcode yang terbaca langsung masuk keranjang.';
  tandaModeScan(!!modeFoto);
}

// Mode mana yang sedang ditawarkan tombol Scan ditulis pada tombolnya, bukan hanya dialami
// setelah ia diketuk: hijau "Scan terus" = tiap barcode yang terbaca langsung masuk keranjang,
// kuning "Potret" = kamera HP dibuka dan harus memotret sekali untuk tiap item.
function tandaModeScan(modeFoto) {
  const terus = !modeFoto && bisaViewfinder();
  const tombol = document.getElementById('btnScan');
  tombol.classList.toggle('scan-terus', terus);
  document.getElementById('scanModeLabel').textContent = terus ? 'Scan terus' : 'Potret';
  tombol.title = terus
    ? 'Scan terus-menerus: tiap barcode yang terbaca langsung masuk keranjang.'
    : 'Potret untuk tiap barcode. Scan tanpa potret butuh alamat https://.';
  tombol.setAttribute('aria-label', terus ? 'Pindai barcode terus-menerus dengan kamera'
    : 'Potret barcode dengan kamera, satu foto untuk tiap item');
  // Baris kuning ini hanya berbicara kalau yang menolak memang alamatnya (konteks non-https).
  // Bila halaman sudah https tapi kameranya yang gagal, alamatnya bukan masalah dan kalimat itu
  // justru menyuruh kasir mencari jalan lain.
  scanAlternatif.textContent = (modeFoto && !window.isSecureContext)
    ? 'Scan tanpa potret butuh https:// - perangkat ini membuka ' + location.origin
    : '';
}

function bipScan() {
  try {
    nada = nada || new (window.AudioContext || window.webkitAudioContext)();
    const o = nada.createOscillator(), g = nada.createGain();
    o.type = 'square';
    o.frequency.value = 1180;
    g.gain.setValueAtTime(0.0001, nada.currentTime);
    g.gain.exponentialRampToValueAtTime(0.07, nada.currentTime + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, nada.currentTime + 0.13);
    o.connect(g);
    g.connect(nada.destination);
    o.start();
    o.stop(nada.currentTime + 0.14);
  } catch (err) { /* perangkat tanpa output audio: getar tetap dicoba */ }
  if (navigator.vibrate) { try { navigator.vibrate(45); } catch (err) {} }
}

// Hasil scan masuk lewat prosesKode(), jalur yang sama dengan Enter dari scanner USB, jadi
// pemindai kamera tidak punya aturan sendiri soal barcode kembar atau stok habis.
function padaKodeScan(kode) {
  const bersih = String(kode || '').trim();
  if (!bersih) return;
  const sekarang = Date.now();
  if (bersih === kodeTerakhir && sekarang - waktuKodeTerakhir < JEDA_ULANG_SCAN) return;
  kodeTerakhir = bersih;
  waktuKodeTerakhir = sekarang;
  const hasil = prosesKode(bersih, true);
  if (hasil.status === 'stok-habis') { statusScan('Stok ' + hasil.produk.name + ' tinggal ' + hasil.stok + '.', 'gagal'); return; }
  if (hasil.status === 'tidak-ada') { statusScan('Barcode ' + bersih + ' tidak ada di produk cabang ini.', 'gagal'); return; }
  if (hasil.status === 'banyak') { statusScan('"' + bersih + '" cocok dengan ' + hasil.jumlah + ' produk - ketuk kartunya.', 'gagal'); return; }
  bipScan();
  statusScan('+ ' + hasil.qty + '  ' + hasil.produk.name + '   Rp ' + formatter.format(hasil.produk.price_sell * hasil.qty), 'ok');
}

function wadahPemindai() {
  if (!pemindai) pemindai = new window.Html5Qrcode('scan-video',
    { verbose: false, formatsToSupport: SCAN_FORMAT, useBarCodeDetectorIfSupported: true });
  return pemindai;
}

async function hentikanViewfinder() {
  pemindaiJalan = false;
  const p = pemindai;
  pemindai = null;
  if (!p) return;
  try { await p.stop(); } catch (err) { /* belum sempat jalan atau sudah berhenti */ }
  try { p.clear(); } catch (err) {}
}

async function mulaiViewfinder() {
  tampilkanOverlay(false);
  statusScan('Menyiapkan kamera...');
  // Ditanya sendiri sebelum pustaka dipakai: html5-qrcode menolak dengan string generik
  // ("Camera failed to start") dan membuang nama error aslinya, jadi tanpa pertanyaan langsung
  // ini layar hanya bilang "tidak bisa dibuka" tanpa pernah tahu kenapa.
  const cek = await cekKamera();
  if (!cek.ok) { turunKeModeFoto(sebabKamera(cek.err)); return; }
  try {
    // Bentuknya bukan MediaTrackConstraints biasa: createVideoConstraints() di dalam bundel
    // menolak objek dengan lebih dari satu kunci dan hanya menerima facingMode sebagai string
    // "user"/"environment" atau {exact: ...} — {ideal: ...} dilempar sebagai
    // "'facingMode' should be string or object with exact as key". String polos juga yang paling
    // longgar: browser memakainya sebagai ideal, jadi perangkat tanpa kamera belakang (webcam
    // laptop di kasir) tetap dapat kamera, bukan OverconstrainedError seperti kalau pakai exact.
    await wadahPemindai().start({ facingMode: 'environment' },
      {
        fps: 10,
        // Bingkai melebar, bukan kotak: barcode satu dimensi butuh lebar garis, dan HP dipegang tegak.
        qrbox: (vw, vh) => {
          const lebar = Math.round(Math.min(vw * 0.9, 340));
          return { width: lebar, height: Math.round(Math.min(lebar * 0.45, vh * 0.45)) };
        },
        rememberLastUsedCamera: true
      },
      padaKodeScan, () => { /* frame tanpa kode: bukan error, biarkan menunggu */ });
    pemindaiJalan = true;
    statusScan('');
  } catch (err) {
    await hentikanViewfinder();
    // Kamera sudah terbukti bisa diminta di atas, jadi kegagalan di sini milik pustaka atau
    // elemen videonya. sebabKamera() sudah menampilkan nama + pesan aslinya di cabang terakhir,
    // jadi tidak perlu diulang lagi di belakangnya.
    turunKeModeFoto(sebabKamera(err));
  }
}

// Sekali pakai untuk mendiagnosis, lalu stream-nya dilepas; viewfinder yang sungguhan dibuka
// oleh pustaka setelahnya. Jeda pendek melepas kamera dengan rapi, karena Chrome Android bisa
// membalas TrackStartError bila stream lama diminta lagi di tick yang sama.
async function cekKamera() {
  if (!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia)) {
    return { ok: false, err: { name: 'NotFoundError', message: 'navigator.mediaDevices tidak ada' } };
  }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } }, audio: false });
    stream.getTracks().forEach(t => t.stop());
    await new Promise(r => setTimeout(r, 250));
    return { ok: true };
  } catch (err) {
    return { ok: false, err: err };
  }
}

// Nama error diterjemahkan jadi satu langkah yang bisa dikerjakan kasir di HP-nya.
function sebabKamera(err) {
  const teks = String((err && err.name) || '') + ' ' + String((err && err.message) || err || '');
  if (/NotAllowedError|Permission|denied|not allowed|permission policy/i.test(teks)) {
    return 'Izin kamera belum diberikan untuk ' + location.host + '. Ketuk ikon gembok di bilah alamat Chrome, pilih Izinkan, lalu muat ulang halaman.';
  }
  if (/NotReadableError|TrackStart|AbortError|in use|busy/i.test(teks)) {
    return 'Kamera sedang dipegang tab atau aplikasi lain. Tutup itu, lalu ketuk "Coba lagi".';
  }
  if (/NotFoundError|DevicesNotFound/i.test(teks)) return 'Perangkat ini tidak punya kamera yang bisa dipakai halaman.';
  if (/OverconstrainedError|ConstraintNotSatisfied/i.test(teks)) return 'Kamera belakang tidak tersedia di perangkat ini.';
  if (/SecurityError/i.test(teks)) return 'Browser menolak kamera di halaman ini (' + location.origin + ').';
  return 'Kamera halaman tidak bisa dibuka (' + (teks.trim() || 'tanpa nama error') + ').';
}

// Mode foto tetap dibuka di belakang penjelasannya: antrean di kasir tidak boleh macet hanya
// karena satu izin kamera, padahal potret selalu bisa dipakai.
function turunKeModeFoto(pesan) {
  kodeTerakhir = '';
  tampilkanOverlay(true);
  scanOverlay.classList.add('scan-gagal');
  statusScan(pesan + ' Potret tetap bisa dipakai.', 'gagal');
}

// Titik masuk tombol "Scan". Viewfinder hanya ditawarkan di konteks aman (https:// tunnel atau
// localhost); di http://192.168.x.x browser menolak getUserMedia, jadi langsung turun ke mode
// foto alih-alih menampilkan layar kamera hitam.
function bukaPemindai() {
  if (bisaViewfinder()) { mulaiViewfinder(); return; }
  mulaiModeFoto();
}

// Jalur kedua: kamera bawaan HP memotret, barcode dibaca dari fotonya. Ini bekerja di mana
// saja - termasuk http://192.168.x.x - karena bukan getUserMedia, melainkan input berkas
// capture yang diizinkan browser di konteks apa pun.
function mulaiModeFoto() {
  if (!window.Html5Qrcode || !SCAN_FORMAT) {
    alert('Pustaka pemindai belum ada di perangkat ini. Buka halaman ini sekali saat server kasir hidup (agar asetnya terunduh), lalu coba lagi.');
    return;
  }
  tampilkanOverlay(true);
  if (pemindaiJalan) hentikanViewfinder();
  statusScan('Kamera HP belum terbuka? Ketuk "Potret ulang".');
  scanFoto.click();
}

async function padaFotoSelesai(ev) {
  const berkas = ev.target.files && ev.target.files[0];
  ev.target.value = '';
  if (!berkas) return;
  tampilkanOverlay(true);
  statusScan('Membaca foto ' + berkas.name + '...');
  try {
    const kode = await wadahPemindai().scanFile(berkas, false);
    padaKodeScan(kode);
  } catch (err) {
    statusScan('Barcode tidak terbaca dari foto itu. Potret lebih dekat, tegak lurus, dan jangan sampai ujung garis terpotong.', 'gagal');
  }
}

function tutupPemindai() {
  scanOverlay.classList.add('is-hidden');
  statusScan('');
  kodeTerakhir = '';
  hentikanViewfinder();
}

scanFoto.addEventListener('change', padaFotoSelesai);
// Penanda tombol dipasang sejak halaman tiba: mode sudah bisa dibaca dari alamatnya, jadi kasir
// tidak perlu mengetuk Scan dulu untuk tahu perangkatnya scan terus atau potret.
tandaModeScan(false);
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !scanOverlay.classList.contains('is-hidden')) { e.stopPropagation(); tutupPemindai(); }
});
// Kamera yang dibiarkan menyala saat halaman ditutup menguras baterai HP dan menahan LED
// scanner menyala, jadi dihentikan juga saat halaman ditinggal.
addEventListener('pagehide', () => { if (!scanOverlay.classList.contains('is-hidden')) hentikanViewfinder(); });
</script>
