<%- include('layout-header') %>
<div class='p-4'>
  <div class='d-flex justify-content-between align-items-center mb-3 no-print'>
    <h2>Laporan Penjualan <%= isManagerOrAdmin ? "& Laba Bersih" : "" %></h2>
    <div>
        <button class='btn btn-outline-dark me-2' onclick='printThermalReport()'><i class='bi bi-receipt'></i> Cetak Struk Thermal (58mm)</button>
        <button class='btn btn-outline-success' onclick='window.print()'><i class='bi bi-file-earmark-pdf'></i> Cetak PDF / A4</button>
    </div>
  </div>

  <% /* Semua tautan laporan membawa filter waktu DAN member supaya berpindah filter
         tidak diam-diam melebarkan hasil yang sedang dilihat. */
     const tautan = (f, m, p) => '/laporan?filter=' + encodeURIComponent(f)
        + (m ? '&member=' + encodeURIComponent(m) : '') + (p ? '&page=' + p : ''); %>
  <div class='btn-group mb-2 no-print' role='group'>
    <a href='<%= tautan("hari_ini", member) %>' class='btn <%= filter === "hari_ini" ? "btn-primary" : "btn-outline-primary" %>'>Hari Ini</a>
    <a href='<%= tautan("bulan_ini", member) %>' class='btn <%= filter === "bulan_ini" ? "btn-primary" : "btn-outline-primary" %>'>Bulan Ini</a>
    <a href='<%= tautan("semua", member) %>' class='btn <%= filter === "semua" ? "btn-primary" : "btn-outline-primary" %>'>Semua Transaksi</a>
  </div>

  <form method='GET' action='/laporan' class='d-flex flex-wrap gap-2 align-items-center mb-4 no-print'>
    <input type='hidden' name='filter' value='<%= filter %>'>
    <label class='mb-0 small text-muted' for='member-filter'>Filter member</label>
    <select id='member-filter' name='member' class='form-select form-select-sm' style='max-width:280px' onchange='this.form.submit()'>
      <option value=''>Semua pelanggan</option>
      <% customers.forEach(c => { %>
        <option value='<%= c.id %>' <%= Number(member) === c.id ? 'selected' : '' %>><%= [c.code, c.name].filter(Boolean).join(' - ') %></option>
      <% }) %>
    </select>
    <% if (member) { %><a href='<%= tautan(filter, 0) %>' class='btn btn-sm btn-outline-secondary'>Hapus filter member</a><% } %>
  </form>

  <% if(isManagerOrAdmin) { %>
  <!-- Kartu Finansial Khusus Admin & Manager Cabang -->
  <div class='row mb-4'>
    <div class='col-md-3 mb-2'>
        <div class='card bg-light border-0 shadow-sm'>
            <div class='card-body'>
                <h6 class='text-muted small'>Omset Penjualan</h6>
                <h4 class='fw-bold text-primary mb-0'>Rp <%= totalRp.toLocaleString('id-ID') %></h4>
                <% if (totalPajak > 0) { %>
                <div class='small text-muted mt-1' title='Omset dikurangi pajak yang dipungut dari pelanggan pada periode ini — angka itu harus disetor, bukan pendapatan toko.'>Omset Bersih Pajak <strong>Rp <%= omsetBersihPajak.toLocaleString('id-ID') %></strong></div>
                <% } %>
                <div class='small text-muted mt-1' title='Semua potongan harga yang diberikan pada periode ini, termasuk potongan voucher. Nota yang dibatalkan tidak dihitung.'>Diskon diberikan <strong class='text-danger'>Rp <%= totalDiskon.toLocaleString('id-ID') %></strong> di <%= notaDiskon %> nota</div>
            </div>
        </div>
    </div>
    <div class='col-md-3 mb-2'>
        <div class='card bg-light border-0 shadow-sm'>
            <div class='card-body'>
                <h6 class='text-muted small'>Total HPP (Modal Beli)</h6>
                <h4 class='fw-bold text-secondary mb-0'>Rp <%= totalCogs.toLocaleString('id-ID') %></h4>
            </div>
        </div>
    </div>
    <div class='col-md-3 mb-2'>
        <div class='card bg-light border-0 shadow-sm'>
            <div class='card-body'>
                <h6 class='text-muted small'>Pengeluaran <%= isAdmin ? "+ Gaji" : "Cabang" %></h6>
                <h4 class='fw-bold text-danger mb-0'>Rp <%= (expTotal + payTotal).toLocaleString('id-ID') %></h4>
            </div>
        </div>
    </div>
    <div class='col-md-3 mb-2'>
        <div class='card bg-success text-white border-0 shadow-sm'>
            <div class='card-body'>
                <h6 class='small'>LABA BERSIH <%= isManager ? "(CABANG)" : "" %></h6>
                <h3 class='fw-bold mb-0'>Rp <%= labaBersih.toLocaleString('id-ID') %></h3>
            </div>
        </div>
    </div>
  </div>
  <% } else { %>
  <!-- Kartu Ringkasan Operasional untuk Role Kasir -->
  <div class='row mb-4'>
    <div class='col-md-6 mb-2'>
        <div class='card bg-primary text-white border-0 shadow-sm'>
            <div class='card-body'>
                <h6>Total Omset Penjualan</h6>
                <h3 class='fw-bold mb-0'>Rp <%= totalRp.toLocaleString('id-ID') %></h3>
                <% if (totalPajak > 0) { %>
                <div class='small mt-1'>Omset Bersih Pajak Rp <%= omsetBersihPajak.toLocaleString('id-ID') %></div>
                <% } %>
                <div class='small mt-1'>Diskon Rp <%= totalDiskon.toLocaleString('id-ID') %> di <%= notaDiskon %> nota</div>
            </div>
        </div>
    </div>
    <div class='col-md-6 mb-2'>
        <div class='card bg-light border-0 shadow-sm'>
            <div class='card-body'>
                <h6 class='text-muted'>Jumlah Transaksi Terproses</h6>
                <h3 class='fw-bold mb-0'><%= totalTx %> Transaksi</h3>
            </div>
        </div>
    </div>
  </div>
  <% } %>

  <!-- Data Tabel Laporan -->
  <div class='card shadow-sm'>
    <div class='card-body table-responsive p-0'>
      <table class='table table-hover align-middle mb-0'>
        <thead class='table-dark'>
          <tr>
            <th>Tgl / Waktu</th>
            <th>No. Nota</th>
            <th>Cabang</th>
            <th>Kasir</th>
            <th>Member</th>
            <th>Metode</th>
            <th class='text-end'>Diskon</th>
            <th class='text-end'>Total Transaksi</th>
            <th>Status</th>
            <% if (isManagerOrAdmin) { %><th class='text-center no-print'>Aksi</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if(sales.length > 0) { sales.forEach(s => { const isVoid = s.status === 'VOID'; const diskon = Number(s.discount) || 0; %>
            <tr class='<%= isVoid ? "table-light text-muted" : "" %>'>
              <td><%= fmtWIB(s.date) %></td>
              <td><strong class='<%= isVoid ? "text-decoration-line-through" : "" %>'><%= s.invoice_no %></strong></td>
              <td><span class='badge bg-secondary'><i class='bi bi-building'></i> <%= s.branch_name || 'Cabang Pusat' %></span></td>
              <td><%= s.kasir || 'Admin' %></td>
              <td><% if (s.customer_name) { %><%= s.customer_name %><% } else { %><span class='text-muted small'>Umum</span><% } %></td>
              <td><span class='badge bg-secondary'><%= s.payment_method %></span></td>
              <td class='text-end <%= isVoid ? "text-decoration-line-through text-muted" : "text-danger" %>'><% if (diskon > 0) { %>- Rp <%= diskon.toLocaleString('id-ID') %><% if (s.voucher_code) { %><div class='small text-muted text-decoration-none'><%= s.voucher_code %></div><% } %><% } else { %><span class='text-muted'>-</span><% } %></td>
              <td class='text-end fw-bold <%= isVoid ? "text-decoration-line-through" : "" %>'>Rp <%= s.total.toLocaleString('id-ID') %></td>
              <td>
                <% if (isVoid) { %>
                  <span class='badge bg-dark'>DIBATALKAN</span>
                <% } else { %>
                  <span class='badge bg-success'>AKTIF</span>
                <% } %>
              </td>
              <% if (isManagerOrAdmin) { %>
              <td class='text-center no-print'>
                <% if (isVoid) { %>
                  <small><%= s.voided_by_name || '-' %><br><%= fmtWIB(s.voided_at) %><br><em><%= s.void_reason || '-' %></em></small>
                <% } else { %>
                  <button class='btn btn-sm btn-outline-danger' data-id='<%= s.id %>' data-no='<%= s.invoice_no %>' onclick='voidSale(this)'><i class='bi bi-x-circle'></i> Batal</button>
                <% } %>
              </td>
              <% } %>
            </tr>
          <% }) } else { %>
            <tr><td colspan='<%= isManagerOrAdmin ? 10 : 9 %>' class='text-center p-4 text-muted'>Tidak ada transaksi pada periode ini.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% const link = (p) => tautan(filter, member, p);
     const mulai = jumlahBaris === 0 ? 0 : pageSize * (page - 1) + 1;
     const akhir = pageSize * (page - 1) + sales.length;
     const windowStart = Math.max(1, Math.min(page - 3, totalPages - 6));
     const windowEnd = Math.min(totalPages, windowStart + 6); %>
  <div class='d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 no-print'>
    <small class='text-muted'>
      Menampilkan <%= mulai %>&ndash;<%= akhir %> dari <%= jumlahBaris %> transaksi
      (halaman <%= page %> dari <%= totalPages %>). Angka ringkasan di atas dihitung untuk
      seluruh <%= jumlahBaris %> transaksi, bukan hanya halaman ini.
    </small>
    <% if (totalPages > 1) { %>
      <nav aria-label='Navigasi halaman laporan'>
        <ul class='pagination pagination-sm mb-0'>
          <li class='page-item <%= page <= 1 ? 'disabled' : '' %>'>
            <a class='page-link' href='<%= link(page - 1) %>'>Sebelumnya</a>
          </li>
          <% if (windowStart > 1) { %>
            <li class='page-item'><a class='page-link' href='<%= link(1) %>'>1</a></li>
            <% if (windowStart > 2) { %><li class='page-item disabled'><span class='page-link'>...</span></li><% } %>
          <% } %>
          <% for (let p = windowStart; p <= windowEnd; p++) { %>
            <li class='page-item <%= p === page ? 'active' : '' %>'>
              <a class='page-link' href='<%= link(p) %>'><%= p %></a>
            </li>
          <% } %>
          <% if (windowEnd < totalPages) { %>
            <% if (windowEnd < totalPages - 1) { %><li class='page-item disabled'><span class='page-link'>...</span></li><% } %>
            <li class='page-item'><a class='page-link' href='<%= link(totalPages) %>'><%= totalPages %></a></li>
          <% } %>
          <li class='page-item <%= page >= totalPages ? 'disabled' : '' %>'>
            <a class='page-link' href='<%= link(page + 1) %>'>Berikutnya</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>

  <% /* Rekap diskon khusus Manager/Admin: tuannya bukan keindahan angka, tapi melihat pola.
         Satu nota berdiskon itu promosi; satu kasir yang berdiskon di hampir semua nota itu
         yang harus ditanyakan. Transaksi VOID sudah terkecuali di query-nya. */ %>
  <% if (isManagerOrAdmin) {
       const persen = (d, s) => (s > 0 ? (d / s * 100).toFixed(1) : '0,0').replace('.', ',');
     %>
  <div class='card shadow-sm mt-4'>
    <div class='card-body'>
      <h5 class='mb-1'>Rekap Diskon &mdash; <%= periodeLabel %></h5>
      <div class='small text-muted mb-3'>
        Dipotong dari <%= totalTx %> transaksi aktif pada periode dan filter yang sedang dipilih.
        "% diskon" = total potongan dibagi subtotal, jadi angka tinggi berarti harga yang benar-benar
        masuk kas jauh di bawah harga daftar.
      </div>
      <div class='row g-4'>
        <div class='col-lg-7'>
          <div class='text-muted small fw-bold text-uppercase mb-2'>Per kasir &amp; cabang</div>
          <table class='table table-sm align-middle mb-0'>
            <thead class='table-light'>
              <tr><th>Kasir</th><th>Cabang</th><th class='text-end'>Nota diskon</th><th class='text-end'>Total Diskon</th><th class='text-end'>% diskon</th></tr>
            </thead>
            <tbody>
              <% if (rekapKasir.length > 0) { rekapKasir.forEach(r => { %>
                <tr>
                  <td><%= r.kasir %></td>
                  <td><span class='badge bg-secondary'><%= r.cabang %></span></td>
                  <td class='text-end'><%= r.tx_diskon %> / <%= r.tx %></td>
                  <td class='text-end fw-bold text-danger'>Rp <%= r.diskon.toLocaleString('id-ID') %></td>
                  <td class='text-end'><%= persen(r.diskon, r.subtotal) %>%</td>
                </tr>
              <% }) } else { %>
                <tr><td colspan='5' class='text-center text-muted py-3'>Tidak ada satu nota pun yang diberi diskon pada periode ini.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class='col-lg-5'>
          <div class='text-muted small fw-bold text-uppercase mb-2'>Per kode voucher</div>
          <table class='table table-sm align-middle mb-0'>
            <thead class='table-light'>
              <tr><th>Kode</th><th class='text-end'>Dipakai</th><th class='text-end'>Total Diskon</th></tr>
            </thead>
            <tbody>
              <% if (rekapVoucher.length > 0) { rekapVoucher.forEach(r => { %>
                <tr>
                  <td><code><%= r.kode %></code></td>
                  <td class='text-end'><%= r.tx %> nota</td>
                  <td class='text-end fw-bold text-danger'>Rp <%= r.diskon.toLocaleString('id-ID') %></td>
                </tr>
              <% }) } else { %>
                <tr><td colspan='3' class='text-center text-muted py-3'>Belum ada potongan yang tercatat pada periode ini.</td></tr>
              <% } %>
            </tbody>
          </table>
          <div class='small text-muted mt-2'>
            "(tanpa kode voucher)" berarti ada potongan yang tercatat di nota tanpa voucher — hanya
            mungkin bila angkanya dibuat sebelum kolom voucher ada, karena diskon kasir selalu dihitung
            dari voucher yang dipilih.
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<div id='print-area' style='display:none;'></div>

<script>
function printThermalReport() {
  const pa = document.getElementById('print-area');
  pa.style.display = 'block';
  const now = new Date();
  const isManagerOrAdminUser = <%= isManagerOrAdmin ? 'true' : 'false' %>;

  let h = "<div style='text-align:center;'><strong><%= settings.store_name %></strong><br>LAPORAN REKAP<% const namaMemberCetak = (customers.find(c => c.id === Number(member)) || {}).name; %><%= namaMemberCetak ? ' - MEMBER ' + namaMemberCetak : '' %><br><strong><%= periodeLabel %></strong><br><small>" + now.toLocaleString('id-ID') + "</small></div><hr style='border-top:1px dashed #000;'>";
  h += "<div style='display:flex; justify-content:space-between;'><span>Total Tx</span><span><%= totalTx %></span></div>";
  h += "<div style='display:flex; justify-content:space-between;'><span>Barang Keluar</span><span><%= totalPcs %> Pcs</span></div>";
  h += "<div style='display:flex; justify-content:space-between;'><span>Omset</span><span>Rp <%= totalRp.toLocaleString('id-ID') %></span></div>";
  h += "<div style='display:flex; justify-content:space-between;'><span>Diskon</span><span><%= totalDiskon.toLocaleString('id-ID') %> (<%= notaDiskon %> nota)</span></div>";
  <% // Angka omset tanpa prefiks "Rp" di baris ini: labelnya sudah panjang dan kertas 44 mm
     // hanya memuat ±30 karakter. %>
  <% if (totalPajak > 0) { %>
  h += "<div style='display:flex; justify-content:space-between;'><span>Omset Bersih Pajak</span><span><%= omsetBersihPajak.toLocaleString('id-ID') %></span></div>";
  <% } %>
  
  if (isManagerOrAdminUser) {
    h += "<div style='display:flex; justify-content:space-between;'><span>HPP</span><span>Rp <%= totalCogs.toLocaleString('id-ID') %></span></div>";
    h += "<div style='display:flex; justify-content:space-between;'><span>Laba Kotor</span><span>Rp <%= labaKotor.toLocaleString('id-ID') %></span></div>";
    h += "<div style='display:flex; justify-content:space-between;'><span>Pengeluaran</span><span>Rp <%= expTotal.toLocaleString('id-ID') %></span></div>";
    h += "<hr style='border-top:1px dashed #000;'><div style='display:flex; justify-content:space-between;'><strong>LABA BERSIH</strong><strong>Rp <%= labaBersih.toLocaleString('id-ID') %></strong></div>";
  }

  // Rincian hanya dicetak bila lebih dari satu periode: untuk filter hari ini daftarnya satu
  // baris yang sama persis dengan ringkasan di atas. Lebar baris dijaga <= 30 karakter karena
  // kertas thermal 58mm hanya memuat sekitar 32 karakter per baris.
  <% if (harian.length > 1) { %>
    h += "<hr style='border-top:1px dashed #000;'><div style='text-align:center;'><strong><%= judulRincian %></strong></div>";
    h += "<div style='display:flex; justify-content:space-between; font-size:10px;'><span>Tanggal  Tx  Pcs</span><span>Omset (Rp)</span></div>";
    <% harian.forEach(r => { %>
      h += "<div style='display:flex; justify-content:space-between;'><span><%= r.label %>  <%= r.tx %>T <%= r.pcs %>P</span><span><%= r.omzet.toLocaleString('id-ID') %></span></div>";
    <% }) %>
  <% } %>

  h += "<hr style='border-top:1px dashed #000;'><div style='text-align:center;'>--- SELESAI ---</div>";
  pa.innerHTML = h;
  document.body.classList.add('print-receipt-mode');
  cetakStrukThermal();
  document.body.classList.remove('print-receipt-mode');
  pa.style.display = 'none';
}

function voidSale(btn) {
  const reason = window.prompt('Alasan pembatalan nota ' + btn.dataset.no + ' (minimal 3 karakter).');
  if (reason === null) return;
  if (reason.trim().length < 3) { window.alert('Alasan pembatalan wajib diisi minimal 3 karakter.'); return; }
  if (!window.confirm('Batalkan ' + btn.dataset.no + '? Barang akan dikembalikan ke stok cabang asal transaksi.')) return;

  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/laporan/void';
  const fields = { id: btn.dataset.id, reason: reason.trim(), filter: '<%= filter %>', member: '<%= member || "" %>' };
  Object.keys(fields).forEach(name => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = name;
    input.value = fields[name];
    form.appendChild(input);
  });
  btn.disabled = true;
  document.body.appendChild(form);
  form.submit();
}
</script>
<%- include('layout-footer') %>