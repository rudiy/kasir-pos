<!DOCTYPE html>
<html lang='id'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>KASIR POS</title>
  <link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet'>
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css'>
  <link rel='stylesheet' href='/css/style.css'>
</head>
<body>
<div class='d-flex'>
  <div class='sidebar p-3 d-none d-md-block flex-shrink-0 no-print' id='appSidebar' style='width: 250px;'>
    <div class='text-center mb-3'>
        <% if(settings && settings.logo) { %>
            <img src='<%= settings.logo %>' alt='Logo' class='img-fluid rounded mb-2' style='max-height: 50px;'>
        <% } else { %>
            <h4 class='text-white'><i class='bi bi-shop'></i> KASIR POS</h4>
        <% } %>
    </div>
    <div class='text-center text-secondary mb-3 small'>
        Halo, <strong><%= user.name %></strong> <br> 
        <span class='badge <%= user.role === "Administrator" ? "bg-primary" : (user.role === "Manager Cabang" ? "bg-warning text-dark" : "bg-info text-dark") %>'><%= user.role %></span>
    </div>
    
    <a href='/' class='<%= typeof path !== "undefined" && path === "/" ? "bg-secondary" : "" %>'><i class='bi bi-speedometer2 me-2'></i> Dashboard</a>
    <a href='/kasir' class='<%= typeof path !== "undefined" && path === "/kasir" ? "bg-secondary" : "" %>'><i class='bi bi-calculator me-2'></i> Kasir (POS)</a>
    <a href='/pelanggan' class='<%= typeof path !== "undefined" && path === "/pelanggan" ? "bg-secondary" : "" %>'><i class='bi bi-people me-2'></i> Pelanggan</a>
    <a href='/laporan' class='<%= typeof path !== "undefined" && path === "/laporan" ? "bg-secondary" : "" %>'><i class='bi bi-file-earmark-bar-graph me-2'></i> Laporan Penjualan</a>

    <% if(isManagerOrAdmin) { %>
        <hr class='text-secondary'>
        <div class='text-secondary small fw-bold mb-2'>STOK BARANG</div>
        <a href='/stok' class='<%= typeof path !== "undefined" && path === "/stok" ? "bg-secondary" : "" %>'><i class='bi bi-clipboard-data me-2'></i> Laporan Stok</a>
        <a href='/transfer' class='<%= typeof path !== "undefined" && path === "/transfer" ? "bg-secondary" : "" %>'><i class='bi bi-truck me-2'></i> Transfer Antar Cabang</a>
        <a href='/produk' class='<%= typeof path !== "undefined" && path === "/produk" ? "bg-secondary" : "" %>'><i class='bi bi-box-seam me-2'></i> Data Produk</a>
        <a href='/opname' class='<%= typeof path !== "undefined" && path === "/opname" ? "bg-secondary" : "" %>'><i class='bi bi-clipboard-check me-2'></i> Stok Opname</a>

        <hr class='text-secondary'>
        <div class='text-secondary small fw-bold mb-2'><%= isAdmin ? "SUPER ADMIN AREA" : "MANAGER CABANG AREA" %></div>
        <a href='/pengeluaran' class='<%= typeof path !== "undefined" && path === "/pengeluaran" ? "bg-secondary" : "" %>'><i class='bi bi-wallet2 me-2'></i> Pengeluaran Operasional</a>
        <a href='/pengguna' class='<%= typeof path !== "undefined" && path === "/pengguna" ? "bg-secondary" : "" %>'><i class='bi bi-person-badge me-2'></i> Kelola Staff Kasir</a>
    <% } %>

    <% if(isAdmin) { %>
        <a href='/cabang' class='<%= typeof path !== "undefined" && path === "/cabang" ? "bg-secondary" : "" %>'><i class='bi bi-building me-2'></i> Cabang Toko</a>
        <a href='/penggajian' class='<%= typeof path !== "undefined" && path === "/penggajian" ? "bg-secondary" : "" %>'><i class='bi bi-cash-stack me-2'></i> Penggajian Gaji</a>
        <a href='/voucher' class='<%= typeof path !== "undefined" && path === "/voucher" ? "bg-secondary" : "" %>'><i class='bi bi-ticket-perforated me-2'></i> Voucher / Diskon</a>
        <a href='/pengaturan/voucher' class='<%= typeof path !== "undefined" && path === "/pengaturan/voucher" ? "bg-secondary" : "" %>'><i class='bi bi-percent me-2'></i> Pajak &amp; Voucher</a>
        <a href='/pengaturan' class='<%= typeof path !== "undefined" && path === "/pengaturan" ? "bg-secondary" : "" %>'><i class='bi bi-gear me-2'></i> Pengaturan Toko</a>
    <% } %>

    <hr class='text-secondary'>
    <a href='/logout' class='text-danger'><i class='bi bi-box-arrow-left me-2'></i> Logout</a>
  </div>

  <div class='flex-grow-1 overflow-auto' style='height: 100vh;'>
    <nav class='navbar navbar-light bg-white border-bottom px-3 no-print'>
        <button class='btn btn-outline-dark btn-sm' onclick='toggleSidebar()'><i class='bi bi-list fs-5'></i></button>
        <span class='fw-bold text-secondary'><%= settings && settings.store_name ? settings.store_name : "KASIR POS" %></span>
    </nav>